<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="BlockBox.App"
    RequestedTheme="Light"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlockBox"
    xmlns:converters="using:BlockBox.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================================================
                 全局字体大小（旧方案，现在由 FontSizeHelper 动态控制）
                 ============================================================ -->
            <x:Double x:Key="GlobalFontSizeNormal">14</x:Double>
            <x:Double x:Key="GlobalFontSizeSmall">12</x:Double>

            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/>

            <!--<Style x:Key="StaticMenuTextButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>-->
            
            <!-- 侧边栏文本颜色；保留应用内的自定义资源键，并跟随系统主题变化 -->
            <SolidColorBrush x:Key="TextFillColorSidebarBrush"
                             Color="{ThemeResource TextFillColorPrimary}" />

            <SolidColorBrush x:Key="TextFillColorTabBarBrush"
                             Color="{ThemeResource TextFillColorPrimary}" />

            <!-- ============================================================
                 样式 1：Edge 风格 TabViewItem
                 作用：标签页的外观，包含顶部圆角、底部反圆角、选中/悬停背景
                 ============================================================ -->
            <Style x:Key="EdgeTabViewItemStyle" TargetType="TabViewItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabViewItem">
                            <!-- 根容器：所有视觉元素都放在这里面 -->
                            <Grid x:Name="LayoutRoot" Background="Transparent">

                                <!-- CommonStates 控制指针状态；SelectionStates 独立控制是否选中。 -->
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Target="HoverVisual.Visibility" Value="Collapsed"/>
                                                <Setter Target="HoverLockVisual.Visibility" Value="Collapsed"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HoverVisual.Visibility" Value="Visible"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="SelectionStates">
                                        <VisualState x:Name="Unselected" />
                                        <VisualState x:Name="Selected" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <!-- 两列布局：左列放文字，右列放关闭按钮 -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 背景路径放入 Canvas，避免其宽度参与 TabViewItem 测量。 -->
                                <Canvas Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        IsHitTestVisible="False">
                                    <!-- 鼠标悬停时的背景（形状同样由 C# 动态生成） -->
                                    <Path x:Name="HoverVisual"
                                          Canvas.Left="-18"
                                          Stretch="None"
                                          Height="38"
                                          Visibility="Collapsed"
                                          Fill="{ThemeResource TabViewItemHeaderBackgroundPointerOver}"/>

                                    <Path x:Name="HoverLockVisual"
                                          Canvas.Left="-18"
                                          Stretch="None"
                                          Height="38"
                                          Visibility="Collapsed"
                                          Fill="{ThemeResource TabViewItemHeaderBackgroundPointerOver}"/>

                                    <!-- 最后绘制选中背景，确保始终覆盖悬停层。 -->
                                    <Path x:Name="SelectedVisual"
                                          Canvas.Left="-18"
                                          Stretch="None"
                                          Height="38"
                                          Visibility="Collapsed"
                                          Fill="{ThemeResource TabViewItemHeaderBackgroundSelected}"/>
                                </Canvas>
                                <!-- 标签文字 -->
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Grid.Column="0"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  Padding="12,0"/>

                                <!-- 关闭按钮（×） -->
                                <Button x:Name="CloseButton"
                                        Grid.Column="1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="3,3"
                                        Margin="0,0,8,0"
                                         Foreground="{TemplateBinding Foreground}"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE711;" FontSize="10"/>
                                </Button>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- ============================================================
                 样式 2：透明“+”按钮（用于 TabStripFooter）
                 作用：默认无背景，鼠标悬停时出现半透明白色
                 ============================================================ -->
            <Style x:Key="TransparentAddButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="Transparent">

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <!-- 普通：完全透明 -->
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Target="BgBorder.Background" Value="Transparent"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <!-- 悬停：叠 25% 白色 -->
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="BgBorder.Background" Value="#40FFFFFF"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <!-- 按下：叠 38% 白色 -->
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="BgBorder.Background" Value="#60FFFFFF"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <!-- 禁用：变灰 -->
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="BgBorder.Background" Value="Transparent"/>
                                                <Setter Target="ContentPresenter.Opacity" Value="0.4"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <!-- 背景层：负责显示悬停/按下颜色 -->
                                <Border x:Name="BgBorder"
                                        Background="Transparent"
                                        CornerRadius="{TemplateBinding CornerRadius}"/>

                                <!-- 图标内容 -->
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- ============================================================
                 样式 3：自定义“添加”按钮（左侧菜单顶部）
                 作用：背景色由 C# 从 INI 读取并设置，
                       悬停/按下时在背景色上叠一层半透明黑色，实现“加深”效果
                 ============================================================ -->
            <Style x:Key="CustomAddButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1B97CF"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- RootGrid 的背景绑定到按钮的 Background 属性 -->
                            <!-- C# 里改 SidebarAddBt.Background = xxx 就能改变基础色 -->
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <!-- 普通：遮罩不显示 -->
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Target="Overlay.Opacity" Value="0"/>
                                            </VisualState.Setters>
                                        </VisualState>

                                        <!-- 悬停：遮罩叠 15% 黑色（基础色变深） -->
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Overlay.Opacity" Value="0.15"/>
                                            </VisualState.Setters>
                                        </VisualState>

                                        <!-- 按下：遮罩叠 30% 黑色（基础色更深） -->
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Overlay.Opacity" Value="0.3"/>
                                            </VisualState.Setters>
                                        </VisualState>

                                        <!-- 禁用：整体变淡 -->
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Opacity" Value="0.5"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <!-- 黑色半透明遮罩层，用来实现加深效果 -->
                                <Border x:Name="Overlay"
                                        Background="White"
                                        Opacity="0"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        IsHitTestVisible="False"/>

                                <!-- 按钮内容（图标 + 文字） -->
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="MenuItemButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="Transparent">

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Target="BgBorder.Background" Value="Transparent"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="BgBorder.Background" Value="#20244A80"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="BgBorder.Background" Value="#40244A80"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Opacity" Value="0.4"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border x:Name="BgBorder"
                                        Background="Transparent"
                                        CornerRadius="{TemplateBinding CornerRadius}"/>

                                <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ✅ 可选状态：按钮背景色 -->
            <Style x:Key="ToolbarIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <!-- ✅ 可选：白底 -->
                                                <Setter Target="BgBorder.Background" Value="#50FFFFFF"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="BgBorder.Background" Value="#50F0F0F0"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="BgBorder.Background" Value="#50E0E0E0"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <!-- ✅ 禁用：透明 -->
                                                <Setter Target="BgBorder.Background" Value="Transparent"/>
                                                <Setter Target="ContentPresenter.Opacity" Value="0.35"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border x:Name="BgBorder" Background="Transparent" CornerRadius="4"/>
                                <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="NoClearButtonTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{ThemeResource TextControlBackground}"/>
                <Setter Property="Foreground" Value="{ThemeResource TextControlForeground}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource TextControlBorderBrush}"/>
                <Setter Property="BorderThickness" Value="{ThemeResource TextControlBorderThemeThickness}"/>
                <Setter Property="Padding" Value="{ThemeResource TextControlThemePadding}"/>
                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>

                                        <VisualState x:Name="PointerOver">

                                        </VisualState>

                                        <VisualState x:Name="Focused">
                                            <VisualState.Setters>
                                                <!-- ⭐ 新增：聚焦时隐藏 Placeholder -->
                                                <Setter Target="PlaceholderTextContentPresenter.Visibility" Value="Collapsed"/>
                                            </VisualState.Setters>

                                        </VisualState>

                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="BackgroundElement.Background" Value="{ThemeResource TextControlBackgroundDisabled}"/>
                                                <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource TextControlBorderBrushDisabled}"/>
                                                <Setter Target="ContentElement.Foreground" Value="{ThemeResource TextControlForegroundDisabled}"/>
                                                <Setter Target="PlaceholderTextContentPresenter.Foreground" Value="{ThemeResource TextControlPlaceholderForegroundDisabled}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <!-- 头部（Header）占位 -->
                                <ContentPresenter x:Name="HeaderContentPresenter"
                                      Grid.Row="0"
                                      Margin="0,0,0,8"
                                      Foreground="{ThemeResource TextControlHeaderForeground}"
                                      Visibility="Collapsed"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"/>

                                <!-- 背景层 -->
                                <Border x:Name="BackgroundElement"
                            Grid.Row="1"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Margin="{TemplateBinding BorderThickness}"/>

                                <!-- 边框层 -->
                                <Border x:Name="BorderElement"
                            Grid.Row="1"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"/>

                                <!-- 文本输入区 -->
                                <ScrollViewer x:Name="ContentElement"
                                  Grid.Row="1"
                                  Padding="{TemplateBinding Padding}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                  VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                  IsTabStop="False"
                                  AutomationProperties.AccessibilityView="Raw"
                                  ZoomMode="Disabled"/>

                                <!-- Placeholder -->
                                <TextBlock x:Name="PlaceholderTextContentPresenter"
                               Grid.Row="1"
                                           
                               Padding="{TemplateBinding Padding}"
                               Foreground="{TemplateBinding PlaceholderForeground}"
                               Text="{TemplateBinding PlaceholderText}"
                               IsHitTestVisible="False"/>

                                <!-- ⚠️ 原来这里有一个 DeleteButton，被删掉了 -->
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBox" BasedOn="{StaticResource NoClearButtonTextBoxStyle}" />
            
            <Style x:Key="TitleBarMenuButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,4"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root"
                      Background="Transparent"
                      CornerRadius="4">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="Transparent"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#20FFFFFF"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#30FFFFFF"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Opacity" Value="0.4"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      Foreground="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
