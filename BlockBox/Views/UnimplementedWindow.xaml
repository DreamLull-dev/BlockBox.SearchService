<Window
    x:Class="BlockBox.Views.UnimplementedWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="">
    <Grid x:Name="Root" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="TitleBarArea" Height="32" VerticalAlignment="Top" Background="Transparent">
            <Button x:Name="CloseButton" Width="46" Height="32" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="Transparent" BorderThickness="0" Click="CloseButton_Click" Content="&#xE8BB;"
                    FontFamily="Segoe MDL2 Assets" FontSize="10" />
        </Grid>
        <TextBlock Grid.Row="1" Text="该功能尚未实现" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="20" FontWeight="SemiBold" />
        <Canvas x:Name="Stage" Grid.RowSpan="2" IsHitTestVisible="False">
            <Image x:Name="Mascot" Width="132" Height="150" Canvas.Left="250" Canvas.Top="155"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="MascotScale" />
                </Image.RenderTransform>
            </Image>
        </Canvas>
    </Grid>
</Window>
