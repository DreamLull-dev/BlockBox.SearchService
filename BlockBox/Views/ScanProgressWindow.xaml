<Window
    x:Class="BlockBox.Views.ScanProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="正在扫描程序">
<Grid x:Name="RootGrid" Padding="24" Background="#10FFFFFF">
        <Border Width="420" Padding="24" CornerRadius="12"
                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="0"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <Image Source="ms-appx:///Assets/StoreLogo.png" Width="56" Height="56"
                       Stretch="Uniform" HorizontalAlignment="Center" />
                <TextBlock Text="BlockBox" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="正在准备扫描..."
                           FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <ProgressBar x:Name="ScanProgressBar" Width="340" Height="4" IsIndeterminate="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
