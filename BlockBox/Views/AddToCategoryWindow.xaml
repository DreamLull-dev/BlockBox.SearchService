<Window
    x:Class="BlockBox.Views.AddToCategoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="">
    <Grid x:Name="RootGrid" Padding="24" RowSpacing="14" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
            <Button x:Name="CategoryButton"
                    Height="32"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="12,0"
                    CornerRadius="15"
                    Background="#14FFFFFF"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1"
                    Click="CategoryButton_Click">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="CategoryIcon" Glyph="&#xE8B7;" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock x:Name="CategoryText" Grid.Column="1" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" Width="80" Height="32" CornerRadius="15" Click="CancelButton_Click" />
            <Button x:Name="SaveButton" Width="80" Height="32" CornerRadius="15" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
