<Window
    x:Class="BlockBox.Views.RecycleBinWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BlockBox.Models"
    Title="回收站">
<Grid x:Name="RootGrid" Padding="20,28,20,20" RowSpacing="14" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="CountText" FontSize="14" Opacity="0.75" />
        </StackPanel>

        <ListView x:Name="EntriesList"
                  Grid.Row="1"
                  SelectionMode="Single"
                  SelectionChanged="EntriesList_SelectionChanged"
                  ContainerContentChanging="EntriesList_ContainerContentChanging">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:RecycleBinEntry">
                    <Grid Padding="8,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="36" Height="36" VerticalAlignment="Center">
                            <FontIcon Tag="RecycleBinIcon"
                                      Glyph="{x:Bind Shortcut.DisplayGlyph}"
                                      FontSize="24"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            <Image Tag="RecycleBinThumbnail"
                                   Width="36"
                                   Height="36"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Shortcut.Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Shortcut.TargetPath}"
                                       TextTrimming="CharacterEllipsis"
                                       Opacity="0.8" />
                            <TextBlock Text="{x:Bind DeletedAt}" FontSize="12" Opacity="0.7" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="EmptyButton"
                    MinWidth="108"
                    Height="32"
                    CornerRadius="15"
                    Click="EmptyButton_Click" />
            <Button x:Name="RestoreButton"
                    MinWidth="108"
                    Height="32"
                    CornerRadius="15" Click="RestoreButton_Click" />
            <Button x:Name="DeleteButton"
                    MinWidth="108"
                    Height="32"
                    CornerRadius="15" Click="DeleteButton_Click" />
        </StackPanel>
    </Grid>
</Window>
