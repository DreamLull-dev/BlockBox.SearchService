<Window
    x:Class="BlockBox.Views.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:BlockBox.Helpers"
    Title="">
    <Grid x:Name="RootGrid" Padding="6" Loaded="RootGrid_Loaded" KeyDown="RootGrid_KeyDown" Background="Transparent">
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FF1F1F1F" />
            </Style>
            <Style TargetType="FontIcon">
                <Setter Property="Foreground" Value="#FF1F1F1F" />
            </Style>
            <Style x:Key="TrayMenuButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Height" Value="34" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="FontSize" Value="14" />
            </Style>
        </Grid.Resources>
        <Border x:Name="MenuBorder"
                VerticalAlignment="Top"
                CornerRadius="8"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="4">
            <StackPanel Spacing="0">
                <Button x:Name="ShowButton" Style="{StaticResource TrayMenuButtonStyle}" Click="ShowButton_Click">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7C4;" FontSize="15" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind helpers:LanguageService.Translate('显示 BlockBox'), Mode=OneWay}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Button x:Name="GlobalSearchButton" Style="{StaticResource TrayMenuButtonStyle}" Click="GlobalSearchButton_Click">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" FontSize="15" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind helpers:LanguageService.Translate('显示全局搜索'), Mode=OneWay}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Button x:Name="SettingsButton" Style="{StaticResource TrayMenuButtonStyle}" Click="SettingsButton_Click">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE713;" FontSize="15" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind helpers:LanguageService.Translate('设置'), Mode=OneWay}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="10,4" />

                <Button x:Name="HideButton" Style="{StaticResource TrayMenuButtonStyle}" Click="HideButton_Click">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE890;" FontSize="15" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind helpers:LanguageService.Translate('隐藏 BlockBox 界面'), Mode=OneWay}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="10,4" />

                <Button x:Name="ExitButton" Style="{StaticResource TrayMenuButtonStyle}" Click="ExitButton_Click">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7E8;" FontSize="15" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind helpers:LanguageService.Translate('退出'), Mode=OneWay}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
