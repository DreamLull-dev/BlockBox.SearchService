<Window
    x:Class="BlockBox.Views.FeedbackWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="">
    <Grid x:Name="RootGrid" Padding="24" RowSpacing="14" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="DescriptionText" Grid.Row="1" TextWrapping="Wrap" Opacity="0.8" LineHeight="20" />
        <StackPanel x:Name="ContactPanel" Grid.Row="2" Spacing="10" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="SendMailButton" Height="32" CornerRadius="15" Click="SendMail_Click" />
            <Button x:Name="CopyButton" Height="32" CornerRadius="15" Click="Copy_Click" />
            <Button x:Name="CloseButton" Height="32" CornerRadius="15" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
