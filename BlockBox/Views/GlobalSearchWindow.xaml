<Window
    x:Class="BlockBox.Views.GlobalSearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlockBox.Views"
    Title="全局搜索">
    <Grid x:Name="RootGrid" Padding="4" RowSpacing="5" Background="Transparent" SizeChanged="RootGrid_SizeChanged" Tapped="RootGrid_Tapped">
        <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="DragRegion" Background="Transparent" Tag="SkipGlobalFontSize">
            <TextBlock Text="全局搜索" Margin="2,-8,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
            <Border x:Name="SearchBoxBorder" Grid.Column="0" Height="32" CornerRadius="15" BorderThickness="1"
                    BorderBrush="#40FFFFFF"
                    Background="#14FFFFFF" Padding="8,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBox x:Name="QueryBox" Grid.Column="1" PlaceholderText="搜索..." TextChanged="QueryBox_TextChanged"
                             Style="{StaticResource NoClearButtonTextBoxStyle}"
                             BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Center"
                             Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                             PlaceholderForeground="{ThemeResource TextFillColorSecondaryBrush}">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                        </TextBox.Resources>
                    </TextBox>
                    <Button x:Name="HistoryButton" Grid.Column="2" Width="22" Height="22" Padding="0"
                            Margin="0,0,2,0" Background="Transparent" BorderThickness="0" CornerRadius="11"
                            VerticalAlignment="Center" Click="HistoryButton_Click" ToolTipService.ToolTip="搜索历史">
                        <FontIcon Glyph="&#xE81C;" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </Button>
                    <Button x:Name="ClearSearchButton" Grid.Column="3" Width="22" Height="22" Padding="0"
                            Margin="2,0,0,0" Background="Transparent" BorderThickness="0" CornerRadius="11"
                            VerticalAlignment="Center" Click="ClearSearch_Click" ToolTipService.ToolTip="清空">
                        <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </Button>
                </Grid>
            </Border>
            <Button x:Name="KindSwitcher" Grid.Column="1" Width="110" Height="32" Padding="10,0,8,0"
                    Background="#14FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="16"
                    Click="KindSwitcher_Click" HorizontalContentAlignment="Stretch">
                <Grid ColumnSpacing="7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <FontIcon x:Name="KindSwitcherIcon" Grid.Column="0" Glyph="&#xE8A5;" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="KindSwitcherText" Grid.Column="1" Text="所有文件" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="None"/>
                    <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </Grid>
        <Border Grid.Row="2" CornerRadius="8" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="#2AFFFFFF">
            <Grid>
        <ListView x:Name="ResultsList" SelectionMode="None" IsItemClickEnabled="False" IsTabStop="True" Loaded="ResultsList_Loaded" ContainerContentChanging="ResultsList_ContainerContentChanging"
                  RightTapped="ResultsList_RightTapped" DoubleTapped="ResultsList_DoubleTapped"
                  Background="Transparent" BorderThickness="0" CornerRadius="8">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SearchResultItem">
                    <Grid Tapped="ResultRow_Tapped">
                        <Border CornerRadius="5"
                                Margin="5,2,5,2"
                                Background="{ThemeResource ListViewItemBackgroundSelected}"
                                Opacity="{x:Bind NormalHighlightOpacity, Mode=OneWay}" IsHitTestVisible="False"/>
                        <Border CornerRadius="5"
                                Margin="5,2,5,2"
                                Background="#33000000"
                                Opacity="{x:Bind CheckedOpacity, Mode=OneWay}" IsHitTestVisible="False"/>
                        <Grid Margin="10,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Width="20" Height="20" Padding="0" BorderThickness="0" CornerRadius="10"
                                Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Click="ResultCheck_Click">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent"/>
                                </Button.Resources>
                                <Grid Width="18" Height="18">
                                    <Border CornerRadius="9" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Opacity="{x:Bind CheckedOpacity, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="White"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border CornerRadius="9" BorderThickness="1"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            Background="#1FFFFFFF" Opacity="{x:Bind UncheckedOpacity, Mode=OneWay}"/>
                                </Grid>
                            </Button>
                            <Grid Grid.Column="1" Width="32" Height="32" VerticalAlignment="Center"
                                  Background="Transparent"
                                  PointerEntered="Thumbnail_PointerEntered"
                                  PointerExited="Thumbnail_PointerExited">
                                <FontIcon Glyph="{x:Bind PlaceholderGlyph}" FontSize="20" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{x:Bind IconSource, Mode=OneWay}" Width="32" Height="32" Stretch="Uniform"/>
                            </Grid>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" Tag="SkipLocalization" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" Tag="SkipLocalization" FontSize="11" Opacity="0.65"/>
                                        <TextBlock Text="{x:Bind ModifiedText, Mode=OneWay}" Tag="SkipLocalization" FontSize="11" Opacity="0.65"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{x:Bind Path, Mode=OneWay}" Tag="SkipLocalization" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
                <!-- 搜索服务不可用时的引导：安装伴侣 MSIX 或启动服务 -->
                <Grid x:Name="ServiceMissingPanel" Visibility="Collapsed" Padding="18">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="300">
                        <FontIcon Glyph="&#xE7BA;" FontSize="26" Opacity="0.6" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ServiceMissingTitle" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock x:Name="ServiceMissingText" FontSize="12" Opacity="0.7"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <Button x:Name="DownloadServiceButton" Click="DownloadService_Click"
                                    CornerRadius="15" Height="32" Padding="14,0"/>
                            <Button x:Name="InstallServiceButton" Click="InstallService_Click"
                                    CornerRadius="15" Height="32" Padding="14,0"/>
                        </StackPanel>
                        <TextBlock x:Name="ServiceMissingHint" FontSize="11" Opacity="0.5"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Grid Grid.Row="3" ColumnSpacing="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <!-- 快速添加到主界面当前选中的分类：仅在该分类接受所有勾选文件时可用 -->
            <Button x:Name="QuickAddButton" Grid.Column="0" Width="32" Height="32" CornerRadius="16" Padding="0"
                    Background="#14FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1"
                    IsEnabled="False" Click="QuickAdd_Click">
                <FontIcon Glyph="&#xE768;" FontSize="10" RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                        <ScaleTransform ScaleX="-1"/>
                    </FontIcon.RenderTransform>
                </FontIcon>
            </Button>
            <Button x:Name="AddButton" Grid.Column="1" Content="添加到" Click="Add_Click" IsEnabled="False" CornerRadius="16"/>
            <Button x:Name="SortButton" Grid.Column="2" Width="88" Height="32" Padding="8,0"
                    Background="#14FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="16"
                    Click="SortButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE8CB;" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="排序" VerticalAlignment="Center"/>
                    <FontIcon Glyph="&#xE70D;" FontSize="9" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="StatusText" Grid.Column="4" MaxWidth="128" Margin="4,0,2,0"
                       VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- 缩略图悬停预览：不接收鼠标，避免自己触发 PointerExited 而闪烁 -->
        <Popup x:Name="ThumbnailPreviewPopup" IsOpen="False">
            <Border x:Name="ThumbnailPreviewBorder"
                    Padding="4"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    IsHitTestVisible="False">
                <Image x:Name="ThumbnailPreviewImage" Stretch="Uniform"/>
            </Border>
        </Popup>
    </Grid>
</Window>
