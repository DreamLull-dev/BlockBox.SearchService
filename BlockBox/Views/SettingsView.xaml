<UserControl
    x:Class="BlockBox.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:BlockBox.Helpers"
    helpers:FontSizeHelper.ApplyGlobalFontScale="True"
    helpers:FontSizeHelper.InitialFontSize="{x:Bind helpers:FontSizeHelper.SettingsBodyInitialFontSize}">
    <UserControl.Resources>
        <Style TargetType="Control">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="SettingsRoot" Padding="24" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton"
                    helpers:PressAnimationHelper.EnableBounce="True"
                    Tag="SkipForeground"
                    Width="100"
                    Height="40"
                    CornerRadius="19"
                    Style="{StaticResource CustomAddButtonStyle}"
                    Background="{x:Bind PrimaryButtonBackground, Mode=OneWay}"
                    Foreground="{x:Bind BackButtonForeground, Mode=OneWay}" 
                    Click="BackButton_Click"
                    Padding="6,3"
                    Opacity="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" Opacity="1" />
                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('返回'), Mode=OneWay}" Opacity="1" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Text="{x:Bind helpers:LanguageService.Translate('设置'), Mode=OneWay}" FontSize="{x:Bind helpers:FontSizeHelper.SettingsTitleInitialFontSize}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <TextBlock x:Name="StatusText" Text="{x:Bind helpers:LanguageService.Translate('正在加载...'), Mode=OneWay}" FontSize="14" Visibility="Collapsed" Margin="0,8,0,0" />

        <Grid Grid.Row="1" Margin="0,18,0,0" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="8"
                    CornerRadius="8"
                    BorderThickness="0.6"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ListView x:Name="SettingsCategoryList"
                          SelectionChanged="SettingsCategoryList_SelectionChanged"
                          SelectionMode="Single">
                    <ListViewItem x:Name="AppearanceCategoryItem" helpers:PressAnimationHelper.EnableBounce="True" Content="主题 / 外观" Tag="Appearance" />
                    <ListViewItem x:Name="GeneralCategoryItem" helpers:PressAnimationHelper.EnableBounce="True" Content="通用" Tag="General" />
                    <ListViewItem x:Name="ProgramsCategoryItem" helpers:PressAnimationHelper.EnableBounce="True" Content="程序 / 扫描" Tag="Programs" />
                    <ListViewItem x:Name="HotkeysCategoryItem" helpers:PressAnimationHelper.EnableBounce="True" Content="快捷键" Tag="Hotkeys" />
                    <ListViewItem x:Name="DataCategoryItem" helpers:PressAnimationHelper.EnableBounce="True" Content="数据 / 备份" Tag="Data" />
                    <ListViewItem x:Name="NotificationsCategoryItem" helpers:PressAnimationHelper.EnableBounce="True" Content="通知 / 提示" Tag="Notifications" />
                    <ListViewItem x:Name="AboutCategoryItem" helpers:PressAnimationHelper.EnableBounce="True" Content="关于我们" Tag="About" />
                </ListView>
            </Border>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="ScrollViewerSettingView" Grid.Column="0"
                          SizeChanged="SettingsScrollViewer_SizeChanged"
                          ViewChanged="SettingsScrollViewer_ViewChanged"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Stretch"
                          MinWidth="380"
                          MaxWidth="700"
                          VerticalScrollBarVisibility="Hidden">
                <StackPanel Spacing="18" MaxWidth="900">

                    <!-- =========================================================
                         主题 / 外观
                         ========================================================= -->
                    <StackPanel x:Name="AppearanceSection" Spacing="18">
                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('主题 / 外观'), Mode=OneWay}"  FontWeight="SemiBold" />
                        <Border Padding="16" CornerRadius="8" BorderThickness="0.6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="0">

                                <TextBlock Text="{x:Bind helpers:LanguageService.Translate('预设主题'), Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('选择主题'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Tag="0" Click="ThemePresetButton_Click"
                                                helpers:PressAnimationHelper.EnableBounce="True"
                                                Padding="0" Width="60" Height="30" CornerRadius="8"
                                                Style="{StaticResource CustomAddButtonStyle}"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                UseSystemFocusVisuals="False">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="14,0,0,14" Background="#FF244A80" />
                                                <Border Grid.Column="1" Width="30" Height="30" CornerRadius="0,14,14,0" Background="#FFF0F0F0" />
                                            </Grid>
                                        </Button>
                                        <Button Tag="1" Click="ThemePresetButton_Click"
                                                helpers:PressAnimationHelper.EnableBounce="True"
                                                Padding="0" Width="60" Height="30" CornerRadius="8"
                                                Style="{StaticResource CustomAddButtonStyle}"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                UseSystemFocusVisuals="False">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="14,0,0,14" Background="#FF202020" />
                                                <Border Grid.Column="1" Width="30" Height="30" CornerRadius="0,14,14,0" Background="#FF303030" />
                                            </Grid>
                                        </Button>
                                        <Button Tag="2" Click="ThemePresetButton_Click"
                                                helpers:PressAnimationHelper.EnableBounce="True"
                                                Padding="0" Width="60" Height="30" CornerRadius="8"
                                                Style="{StaticResource CustomAddButtonStyle}"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                UseSystemFocusVisuals="False">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="14,0,0,14" Background="#FF6B7D99" />
                                                <Border Grid.Column="1" Width="30" Height="30" CornerRadius="0,14,14,0" Background="#FFA9B8CB" />
                                            </Grid>
                                        </Button>
                                        <Button Tag="3" Click="ThemePresetButton_Click"
                                                helpers:PressAnimationHelper.EnableBounce="True"
                                                Padding="0" Width="60" Height="30" CornerRadius="8"
                                                Style="{StaticResource CustomAddButtonStyle}"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                UseSystemFocusVisuals="False">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="14,0,0,14" Background="#FFC62828" />
                                                <Border Grid.Column="1" Width="30" Height="30" CornerRadius="0,14,14,0" Background="#FFFFCDD2" />
                                            </Grid>
                                        </Button>
                                        <Button Tag="4" Click="ThemePresetButton_Click"
                                                helpers:PressAnimationHelper.EnableBounce="True"
                                                Padding="0" Width="60" Height="30" CornerRadius="8"
                                                Style="{StaticResource CustomAddButtonStyle}"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                UseSystemFocusVisuals="False">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="14,0,0,14" Background="#FF6D4C41" />
                                                <Border Grid.Column="1" Width="30" Height="30" CornerRadius="0,14,14,0" Background="#FFD7CCC8" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <!-- 自定义背景色 -->
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('自定义背景色'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Width="140"
                                            Padding="12,6"
                                            CornerRadius="16"
                                            Background="White"
                                            BorderThickness="0.6"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <Button.Flyout>
                                            <Flyout x:Name="PrimaryColorFlyout">
                                                <StackPanel>
                                                    <Viewbox Width="277.33" HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly">
                                                        <ColorPicker x:Name="PrimaryColorPicker"
                                                                     Width="346.67"
                                                                     ColorChanged="ColorPicker_ColorChanged"
                                                                     IsMoreButtonVisible="False"
                                                                     IsColorPreviewVisible="True" />
                                                    </Viewbox>
                                                    <Button Content="{x:Bind helpers:LanguageService.Translate('完成'), Mode=OneWay}"
                                                            Tag="PrimaryColorFlyout"
                                                            Width="80"
                                                            HorizontalAlignment="Right"
                                                            CornerRadius="14"
                                                            Click="ColorPickerDone_Click" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind PrimaryColorHex, Mode=OneWay}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                    Width="24" Height="16" CornerRadius="3"
                                                    Background="{x:Bind PrimaryColorBrush, Mode=OneWay}"
                                                    Margin="8,0,8,0"/>
                                            <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <!-- 自定义前景色 -->
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('自定义前景色'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Width="140"
                                            Padding="12,6"
                                            CornerRadius="16"
                                            Background="White"
                                            BorderThickness="0.6"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <Button.Flyout>
                                            <Flyout x:Name="MainContentColorFlyout">
                                                <StackPanel>
                                                    <Viewbox Width="277.33" HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly">
                                                        <ColorPicker x:Name="MainContentColorPicker"
                                                                     Width="346.67"
                                                                     ColorChanged="ColorPicker_ColorChanged"
                                                                     IsMoreButtonVisible="False"
                                                                     IsColorPreviewVisible="True" />
                                                    </Viewbox>
                                                    <Button Content="{x:Bind helpers:LanguageService.Translate('完成'), Mode=OneWay}"
                                                            Tag="MainContentColorFlyout"
                                                            Width="80"
                                                            HorizontalAlignment="Right"
                                                            CornerRadius="14"
                                                            Click="ColorPickerDone_Click" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind MainContentColorHex, Mode=OneWay}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                    Width="24" Height="16" CornerRadius="3"
                                                    Background="{x:Bind MainContentColorBrush, Mode=OneWay}"
                                                    Margin="8,0,8,0"/>
                                            <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <!-- 自定义左侧菜单色 -->
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('自定义左侧菜单色'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Width="140"
                                            Padding="12,6"
                                            CornerRadius="16"
                                            Background="White"
                                            BorderThickness="0.6"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <Button.Flyout>
                                            <Flyout x:Name="SidebarBackgroundColorFlyout">
                                                <StackPanel>
                                                    <Viewbox Width="277.33" HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly">
                                                        <ColorPicker x:Name="SidebarBackgroundColorPicker"
                                                                     Width="346.67"
                                                                     ColorChanged="ColorPicker_ColorChanged"
                                                                     IsMoreButtonVisible="False"
                                                                     IsColorPreviewVisible="True" />
                                                    </Viewbox>
                                                    <Button Content="{x:Bind helpers:LanguageService.Translate('完成'), Mode=OneWay}"
                                                            Tag="SidebarBackgroundColorFlyout"
                                                            Width="80"
                                                            HorizontalAlignment="Right"
                                                            CornerRadius="14"
                                                            Click="ColorPickerDone_Click" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind SidebarBackgroundColorHex, Mode=OneWay}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                    Width="24" Height="16" CornerRadius="3"
                                                    Background="{x:Bind SidebarBackgroundColorBrush, Mode=OneWay}"
                                                    Margin="8,0,8,0"/>
                                            <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <!-- 自定义字体色 -->
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('自定义字体色'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Width="140"
                                            Padding="12,6"
                                            CornerRadius="16"
                                            Background="White"
                                            BorderThickness="0.6"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <Button.Flyout>
                                            <Flyout x:Name="FontColorFlyout" Opened="FontColorFlyout_Opened">
                                                <StackPanel>
                                                    <CheckBox x:Name="FontColorAutoToggle"
                                                              Content="{x:Bind helpers:LanguageService.Translate('自动（深色 / 浅色）'), Mode=OneWay}"
                                                              IsChecked="True"
                                                              Checked="FontColorAutoToggle_Changed"
                                                              Unchecked="FontColorAutoToggle_Changed"
                                                              MaxWidth="277"
                                                              HorizontalAlignment="Left"
                                                              Margin="0,0,0,6"/>
                                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('开启后按背景自动提亮或压暗文字；关闭后严格使用所选颜色。'), Mode=OneWay}"
                                                               Opacity="0.65"
                                                               TextWrapping="Wrap"
                                                               MaxWidth="277"
                                                               Margin="0,0,0,8"/>
                                                    <Viewbox Width="277.33" HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly">
                                                        <ColorPicker x:Name="FontColorPicker"
                                                                     Width="346.67"
                                                                     ColorChanged="ColorPicker_ColorChanged"
                                                                     IsMoreButtonVisible="False"
                                                                     IsColorPreviewVisible="True"
                                                                     IsAlphaSliderVisible="False"
                                                                     IsAlphaTextInputVisible="False" />
                                                    </Viewbox>
                                                    <Button Content="{x:Bind helpers:LanguageService.Translate('完成'), Mode=OneWay}"
                                                            Tag="FontColorFlyout"
                                                            Width="80"
                                                            HorizontalAlignment="Right"
                                                            CornerRadius="14"
                                                            Click="ColorPickerDone_Click" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind FontColorHex, Mode=OneWay}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                    Width="24" Height="16" CornerRadius="3"
                                                    Background="{x:Bind FontColorBrush, Mode=OneWay}"
                                                    Margin="8,0,8,0"/>
                                            <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <!-- 自定义内容区字体色 -->
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('自定义内容区字体色'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Width="140"
                                            Padding="12,6"
                                            CornerRadius="16"
                                            Background="White"
                                            BorderThickness="0.6"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <Button.Flyout>
                                            <Flyout x:Name="ShortcutGridFontColorFlyout" Opened="ShortcutGridFontColorFlyout_Opened">
                                                <StackPanel>
                                                    <CheckBox x:Name="ShortcutGridFontColorAutoToggle"
                                                              Content="{x:Bind helpers:LanguageService.Translate('跟随全局字体色'), Mode=OneWay}"
                                                              IsChecked="True"
                                                              Checked="ShortcutGridFontColorAutoToggle_Changed"
                                                              Unchecked="ShortcutGridFontColorAutoToggle_Changed"
                                                              MaxWidth="277"
                                                              HorizontalAlignment="Left"
                                                              Margin="0,0,0,6"/>
                                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('开启后内容区使用全局字体色；关闭后使用这里的颜色。是否自动校正由全局“自动”开关决定。'), Mode=OneWay}"
                                                               Opacity="0.65"
                                                               TextWrapping="Wrap"
                                                               MaxWidth="277"
                                                               Margin="0,0,0,8"/>
                                                    <Viewbox Width="277.33" HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly">
                                                        <ColorPicker x:Name="ShortcutGridFontColorPicker"
                                                                     Width="346.67"
                                                                     ColorChanged="ColorPicker_ColorChanged"
                                                                     IsMoreButtonVisible="False"
                                                                     IsColorPreviewVisible="True"
                                                                     IsAlphaSliderVisible="False"
                                                                     IsAlphaTextInputVisible="False" />
                                                    </Viewbox>
                                                    <Button Content="{x:Bind helpers:LanguageService.Translate('完成'), Mode=OneWay}"
                                                            Tag="ShortcutGridFontColorFlyout"
                                                            Width="80"
                                                            HorizontalAlignment="Right"
                                                            CornerRadius="14"
                                                            Click="ColorPickerDone_Click" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind ShortcutGridFontColorHex, Mode=OneWay}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                    Width="24" Height="16" CornerRadius="3"
                                                    Background="{x:Bind ShortcutGridFontColorBrush, Mode=OneWay}"
                                                    Margin="8,0,8,0"/>
                                            <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <!-- 遮罩颜色 -->
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('遮罩颜色'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Width="140"
                                            Padding="12,6"
                                            CornerRadius="16"
                                            Background="White"
                                            BorderThickness="0.6"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <Button.Flyout>
                                            <Flyout x:Name="OverlayColorFlyout">
                                                <StackPanel>
                                                    <Viewbox Width="277.33" HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly">
                                                        <ColorPicker x:Name="OverlayColorPicker"
                                                                     Width="346.67"
                                                                     ColorChanged="ColorPicker_ColorChanged"
                                                                     IsMoreButtonVisible="False"
                                                                     IsColorPreviewVisible="True" />
                                                    </Viewbox>
                                                    <Button Content="{x:Bind helpers:LanguageService.Translate('完成'), Mode=OneWay}"
                                                            Tag="OverlayColorFlyout"
                                                            Width="80"
                                                            HorizontalAlignment="Right"
                                                            CornerRadius="14"
                                                            Click="ColorPickerDone_Click" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind OverlayColorHex, Mode=OneWay}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                    Width="24" Height="16" CornerRadius="3"
                                                    Background="{x:Bind OverlayColorBrush, Mode=OneWay}"
                                                    Margin="8,0,8,0"/>
                                            <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10"/>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <!-- 背景模式 / 遮罩强度 -->
                                <StackPanel Padding="0,10" Spacing="8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('左侧菜单自定义背景'), Mode=OneWay}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <ComboBox x:Name="SidebarBackgroundModeComboBox"
                      MinWidth="100" Height="32" CornerRadius="15"
                      Opacity="1" Background="White"
                      SelectionChanged="ComboSetting_SelectionChanged">
                                                <ComboBoxItem Content="{x:Bind helpers:LanguageService.Translate('纯色'), Mode=OneWay}" />
                                                <ComboBoxItem Content="{x:Bind helpers:LanguageService.Translate('图片'), Mode=OneWay}" />
                                                <ComboBoxItem Content="{x:Bind helpers:LanguageService.Translate('视频'), Mode=OneWay}" />
                                            </ComboBox>
                                            <Button x:Name="SidebarBgPickButton" Content="{x:Bind helpers:LanguageService.Translate('选择'), Mode=OneWay}"
                    MinWidth="60" Height="32" CornerRadius="15"
                    Click="SidebarBgPickButton_Click" IsEnabled="False"/>
                                            <Button x:Name="SidebarBgClearButton" Content="{x:Bind helpers:LanguageService.Translate('清除'), Mode=OneWay}"
                    MinWidth="60" Height="32" CornerRadius="15"
                    Click="SidebarBgClearButton_Click" IsEnabled="False"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="SidebarBgPathText"
                FontSize="{x:Bind helpers:FontSizeHelper.SettingsSmallInitialFontSize}" Opacity="0.6"
               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <StackPanel Padding="0,10" Spacing="8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('内容栏自定义背景'), Mode=OneWay}" VerticalAlignment="Center"/>
