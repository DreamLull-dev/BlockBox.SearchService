                                             Width="200"
                                             Minimum="0" Maximum="4"
                                             StepFrequency="1"
                                             TickFrequency="1"
                                             TickPlacement="BottomRight"
                                            ValueChanged="FontSizeScaleSlider_ValueChanged" />
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('字体族'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="FontFamilyComboBox"
          Width="180" Height="32" CornerRadius="15"
          Opacity="1" Background="White"
          DisplayMemberPath="DisplayName"
          SelectionChanged="FontFamilyComboBox_SelectionChanged">
                                    </ComboBox>
                                </Grid>

                            </StackPanel>
                        </Border>

                        <!-- 卡片加载动画 -->
                        <Border Padding="16" CornerRadius="8" BorderThickness="0.6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="0">
                                <TextBlock Text="{x:Bind helpers:LanguageService.Translate('卡片加载动画'), Mode=OneWay}" FontSize="{x:Bind helpers:FontSizeHelper.SettingsTitleInitialFontSize}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('动画效果'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="ShortcutLoadAnimationComboBox"
                                              Width="190" Height="32" CornerRadius="15"
                                              Opacity="1" Background="White"
                                              SelectionChanged="ShortcutLoadAnimationComboBox_SelectionChanged">
                                        <ComboBoxItem Content="{x:Bind helpers:LanguageService.Translate('原有动画'), Mode=OneWay}"/>
                                        <ComboBoxItem Content="{x:Bind helpers:LanguageService.Translate('中心缩放回归'), Mode=OneWay}"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 启动 / 系统 -->
                        <Border Padding="16" CornerRadius="8" BorderThickness="0.6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="0">
                                <TextBlock Text="{x:Bind helpers:LanguageService.Translate('启动 / 系统'), Mode=OneWay}" FontSize="{x:Bind helpers:FontSizeHelper.SettingsTitleInitialFontSize}" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('开机自动启动'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" x:Name="AutoStartToggle"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Toggled="GenericSetting_Toggled" />
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('退出后进入托盘'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" x:Name="TrayOnExitToggle"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Toggled="GenericSetting_Toggled" />
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('最小化时隐藏到托盘'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" x:Name="HideOnMinimizeToggle"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Toggled="GenericSetting_Toggled" />
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('启动时恢复上次打开的标签'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" x:Name="RestoreLastTabToggle"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Toggled="GenericSetting_Toggled" />
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('程序启动后打开全局搜索'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" x:Name="OpenSearchOnStartupToggle"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Toggled="GenericSetting_Toggled" />
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('添加到分类后取消勾选'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" x:Name="ClearSearchSelectionAfterAddToggle"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Toggled="GenericSetting_Toggled" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 功能 -->
                        <Border Padding="16" CornerRadius="8" BorderThickness="0.6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="0">
                                <TextBlock Text="{x:Bind helpers:LanguageService.Translate('功能'), Mode=OneWay}" FontSize="{x:Bind helpers:FontSizeHelper.SettingsTitleInitialFontSize}" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('左侧菜单默认展开'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" x:Name="SidebarExpandedToggle"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Toggled="SidebarExpandedToggle_Toggled" />
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('显示文件扩展名'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" x:Name="ShowExtensionToggle"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Toggled="ShowExtensionToggle_Toggled" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- =========================================================
                         程序 / 扫描
                         ========================================================= -->
                    <StackPanel x:Name="ProgramsSection" Spacing="18" Visibility="Collapsed">
                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('程序 / 扫描'), Mode=OneWay}" FontSize="{x:Bind helpers:FontSizeHelper.SettingsTitleInitialFontSize}" FontWeight="SemiBold" />

                        <Border Padding="16" CornerRadius="8" BorderThickness="0.6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="0">
                                <TextBlock Text="{x:Bind helpers:LanguageService.Translate('扫描与分类'), Mode=OneWay}" FontSize="{x:Bind helpers:FontSizeHelper.SettingsTitleInitialFontSize}" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                <!-- 扫描安装程序 -->
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('扫描安装程序'), Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('扫描本机已安装程序并按分类导入'), Mode=OneWay}"
                                                   FontSize="{x:Bind helpers:FontSizeHelper.SettingsSmallInitialFontSize}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="ImportProgramsButton"
                                            helpers:PressAnimationHelper.EnableBounce="True"
                                            Tag="SkipForeground"
                                            Content="{x:Bind helpers:LanguageService.Translate('开始扫描'), Mode=OneWay}"
                                            Width="100" Height="32"
                                            Opacity="1"
                                            Style="{StaticResource CustomAddButtonStyle}"
                                            Background="{x:Bind PrimaryButtonBackground, Mode=OneWay}"
                                            CornerRadius="15"
                                            VerticalAlignment="Center"
                                            Click="ImportInstalledPrograms_Click" />
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('程序分类记录'), Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('管理手动分类记录和自动分类排除规则'), Mode=OneWay}"
                                                   FontSize="{x:Bind helpers:FontSizeHelper.SettingsSmallInitialFontSize}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="ManageProgramCategoryHistoryButton"
                                            helpers:PressAnimationHelper.EnableBounce="True"
                                            Tag="SkipForeground"
                                            Content="{x:Bind helpers:LanguageService.Translate('管理'), Mode=OneWay}"
                                            Width="100" Height="32"
                                            Opacity="1"
                                            Style="{StaticResource CustomAddButtonStyle}"
                                            Background="{x:Bind PrimaryButtonBackground, Mode=OneWay}"
                                            CornerRadius="15"
                                            VerticalAlignment="Center"
                                            Click="ManageProgramCategoryHistory_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Padding="16" CornerRadius="8" BorderThickness="0.6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="0">
                                <TextBlock Text="{x:Bind helpers:LanguageService.Translate('扫描选项'), Mode=OneWay}" FontSize="{x:Bind helpers:FontSizeHelper.SettingsTitleInitialFontSize}" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('忽略无图标的组件程序'), Mode=OneWay}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('没有图标、名称像卸载器、更新器或辅助进程的程序不会加入分类；手动添加的项目不受影响。'), Mode=OneWay}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="HideNoIconComponentProgramsToggle"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Toggled="GenericSetting_Toggled" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- =========================================================
                         全局热键
                         ========================================================= -->
                    <StackPanel x:Name="HotkeysSection" Spacing="18" Visibility="Collapsed">
                        <StackPanel.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#80000000" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#80000000" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#80000000" />
                            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#80000000" />
                            <Thickness x:Key="TextControlBorderThemeThickness">0.5</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            <Style TargetType="TextBox" BasedOn="{StaticResource NoClearButtonTextBoxStyle}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="#80000000" />
                                <Setter Property="BorderThickness" Value="0.5" />
                                <Setter Property="SelectionHighlightColor" Value="Transparent" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="UseSystemFocusVisuals" Value="False" />
                                <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('快捷键'), Mode=OneWay}" FontSize="{x:Bind helpers:FontSizeHelper.SettingsTitleInitialFontSize}" FontWeight="SemiBold" />
                        <Border Padding="16" CornerRadius="8" BorderThickness="0.6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{x:Bind helpers:LanguageService.Translate('快捷键配置入口'), Mode=OneWay}" FontSize="{x:Bind helpers:FontSizeHelper.SettingsTitleInitialFontSize}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind helpers:LanguageService.Translate('支持 Ctrl、Alt、Shift 或 Win 加字母、数字、功能键。修改后立即生效。'), Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('添加文件'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="HotkeyAddTextBox" Grid.Column="1" PlaceholderText="Ctrl+Alt+N" IsReadOnly="True" LostFocus="HotkeyTextBox_LostFocus" PointerPressed="HotkeyTextBox_PointerPressed" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                                </Grid>
                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('剪切'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="HotkeyCutTextBox" Grid.Column="1" PlaceholderText="Ctrl+Alt+X" IsReadOnly="True" LostFocus="HotkeyTextBox_LostFocus" PointerPressed="HotkeyTextBox_PointerPressed" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                                </Grid>
                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('复制'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="HotkeyCopyTextBox" Grid.Column="1" PlaceholderText="Ctrl+Alt+C" IsReadOnly="True" LostFocus="HotkeyTextBox_LostFocus" PointerPressed="HotkeyTextBox_PointerPressed" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                                </Grid>
                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('粘贴'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="HotkeyPasteTextBox" Grid.Column="1" PlaceholderText="Ctrl+Alt+V" IsReadOnly="True" LostFocus="HotkeyTextBox_LostFocus" PointerPressed="HotkeyTextBox_PointerPressed" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                                </Grid>
                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('重命名'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="HotkeyRenameTextBox" Grid.Column="1" PlaceholderText="Ctrl+Alt+R" IsReadOnly="True" LostFocus="HotkeyTextBox_LostFocus" PointerPressed="HotkeyTextBox_PointerPressed" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                                </Grid>
                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('删除'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="HotkeyDeleteTextBox" Grid.Column="1" PlaceholderText="Ctrl+Alt+D" IsReadOnly="True" LostFocus="HotkeyTextBox_LostFocus" PointerPressed="HotkeyTextBox_PointerPressed" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                                </Grid>
                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('新建分类'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="HotkeyNewCategoryTextBox" Grid.Column="1" PlaceholderText="Ctrl+Alt+G" IsReadOnly="True" LostFocus="HotkeyTextBox_LostFocus" PointerPressed="HotkeyTextBox_PointerPressed" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                                </Grid>
                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('新建标签'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="HotkeyNewTabTextBox" Grid.Column="1" PlaceholderText="Ctrl+Alt+T" IsReadOnly="True" LostFocus="HotkeyTextBox_LostFocus" PointerPressed="HotkeyTextBox_PointerPressed" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                                </Grid>
                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('全选'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="HotkeySelectAllTextBox" Grid.Column="1" PlaceholderText="Ctrl+A" IsReadOnly="True" LostFocus="HotkeyTextBox_LostFocus" PointerPressed="HotkeyTextBox_PointerPressed" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                                </Grid>
                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('收藏'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="HotkeyFavoriteTextBox" Grid.Column="1" PlaceholderText="Ctrl+Q" IsReadOnly="True" LostFocus="HotkeyTextBox_LostFocus" PointerPressed="HotkeyTextBox_PointerPressed" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- =========================================================
                         数据 / 备份
                         ========================================================= -->
                    <StackPanel x:Name="DataSection" Spacing="18" Visibility="Collapsed">
                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('数据 / 备份'), Mode=OneWay}" FontSize="{x:Bind helpers:FontSizeHelper.SettingsTitleInitialFontSize}" FontWeight="SemiBold" />
                        <Border Padding="16" CornerRadius="8" BorderThickness="0.6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="0">

                                <!-- 导出配置 -->
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('导出配置'), Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('把当前设置导出为文件，用于备份或迁移'), Mode=OneWay}"
                                                   FontSize="{x:Bind helpers:FontSizeHelper.SettingsSmallInitialFontSize}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="ExportSettingsButton"
                                            Content="{x:Bind helpers:LanguageService.Translate('导出'), Mode=OneWay}"
                                            helpers:PressAnimationHelper.EnableBounce="True"
                                            Tag="SkipForeground"
                                            Width="80" Height="32"
                                            Opacity="1"
                                            Style="{StaticResource CustomAddButtonStyle}"
                                            Background="{x:Bind PrimaryButtonBackground, Mode=OneWay}"
                                            CornerRadius="15"
                                            VerticalAlignment="Center"
                                            Click="ExportSettingsButton_Click" />
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <!-- 导入配置 -->
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('导入配置'), Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('从导出的配置文件恢复设置'), Mode=OneWay}"
                                                   FontSize="{x:Bind helpers:FontSizeHelper.SettingsSmallInitialFontSize}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="ImportSettingsButton"
                                            Content="{x:Bind helpers:LanguageService.Translate('导入'), Mode=OneWay}"
                                            helpers:PressAnimationHelper.EnableBounce="True"
                                            Tag="SkipForeground"
                                            Width="80" Height="32"
                                            Opacity="1"
                                            Style="{StaticResource CustomAddButtonStyle}"
                                            Background="{x:Bind PrimaryButtonBackground, Mode=OneWay}"
                                            CornerRadius="15"
                                            VerticalAlignment="Center"
                                            Click="ImportSettingsButton_Click" />
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <!-- 备份数据库 -->
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('备份数据库'), Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('将分类、标签、快捷方式记录打包备份'), Mode=OneWay}"
                                                   FontSize="{x:Bind helpers:FontSizeHelper.SettingsSmallInitialFontSize}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BackupDatabaseButton"
                                            Tag="SkipForeground"
                                            Content="{x:Bind helpers:LanguageService.Translate('备份'), Mode=OneWay}"
                                            helpers:PressAnimationHelper.EnableBounce="True"
                                            Width="80" Height="32"
                                            Opacity="1"
                                            Style="{StaticResource CustomAddButtonStyle}"
                                            Background="{x:Bind PrimaryButtonBackground, Mode=OneWay}"
                                            CornerRadius="15"
                                            VerticalAlignment="Center"
                                            Click="BackupDatabaseButton_Click" />
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <!-- 恢复数据库 -->
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('恢复数据库'), Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('从数据库备份中还原记录（会覆盖当前数据）'), Mode=OneWay}"
                                                   FontSize="{x:Bind helpers:FontSizeHelper.SettingsSmallInitialFontSize}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="RestoreDatabaseButton"
                                            Tag="SkipForeground"
                                            Content="{x:Bind helpers:LanguageService.Translate('恢复'), Mode=OneWay}"
                                            helpers:PressAnimationHelper.EnableBounce="True"
                                            Width="80" Height="32"
                                            Opacity="1"
                                            Style="{StaticResource CustomAddButtonStyle}"
                                            Background="{x:Bind PrimaryButtonBackground, Mode=OneWay}"
                                            CornerRadius="15"
                                            VerticalAlignment="Center"
                                            Click="RestoreDatabaseButton_Click" />
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <!-- 清空图标缓存 -->
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('清空图标缓存'), Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('清除内存与磁盘中的程序图标缓存'), Mode=OneWay}"
                                                   FontSize="{x:Bind helpers:FontSizeHelper.SettingsSmallInitialFontSize}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="ClearIconCacheButton"
                                            Tag="SkipForeground"
                                            Content="{x:Bind helpers:LanguageService.Translate('清空'), Mode=OneWay}"
                                            helpers:PressAnimationHelper.EnableBounce="True"
                                            Width="80" Height="32"
                                            Opacity="1"
                                            Style="{StaticResource CustomAddButtonStyle}"
                                            Background="{x:Bind PrimaryButtonBackground, Mode=OneWay}"
                                            CornerRadius="15"
                                            VerticalAlignment="Center"
                                            Click="ClearIconCacheButton_Click" />
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <!-- 重置所有设置 -->
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('重置所有设置'), Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('恢复所有外观、行为设置为默认值'), Mode=OneWay}"
                                                   FontSize="{x:Bind helpers:FontSizeHelper.SettingsSmallInitialFontSize}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="ResetSettingsButton"
                                            Tag="SkipForeground"
                                            Content="{x:Bind helpers:LanguageService.Translate('重置'), Mode=OneWay}"
                                            helpers:PressAnimationHelper.EnableBounce="True"
                                            Width="80" Height="32"
                                            Opacity="1"
                                            Style="{StaticResource CustomAddButtonStyle}"
                                            Background="{x:Bind PrimaryButtonBackground, Mode=OneWay}"
                                            CornerRadius="15"
                                            VerticalAlignment="Center"
                                            Click="ResetSettingsButton_Click" />
                                </Grid>

                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- =========================================================
                         通知 / 提示
                         ========================================================= -->
                    <StackPanel x:Name="NotificationsSection" Spacing="18" Visibility="Collapsed">
                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('通知 / 提示'), Mode=OneWay}" FontSize="{x:Bind helpers:FontSizeHelper.SettingsTitleInitialFontSize}" FontWeight="SemiBold" />
                        <Border Padding="16" CornerRadius="8" BorderThickness="0.6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="0">

                                <!-- 显示操作成功提示 -->
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('显示操作成功提示'), Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('添加、复制、粘贴等完成后弹出提示'), Mode=OneWay}"
                                                   FontSize="{x:Bind helpers:FontSizeHelper.SettingsSmallInitialFontSize}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="SuccessNotificationToggle"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Toggled="GenericSetting_Toggled" />
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <!-- 显示重载配置完成提示 -->
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('显示重载配置完成提示'), Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('设置更改后提示配置已生效'), Mode=OneWay}"
                                                   FontSize="{x:Bind helpers:FontSizeHelper.SettingsSmallInitialFontSize}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="ReloadNotificationToggle"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Toggled="GenericSetting_Toggled" />
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <!-- 删除时显示确认框 -->
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('删除时显示确认框'), Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('删除记录或分类前弹出二次确认'), Mode=OneWay}"
                                                   FontSize="{x:Bind helpers:FontSizeHelper.SettingsSmallInitialFontSize}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="ConfirmDeleteToggle"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Toggled="GenericSetting_Toggled" />
                                </Grid>

                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <!-- 清空回收站时显示确认框 -->
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('清空回收站时显示确认框'), Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('清空回收站前弹出二次确认'), Mode=OneWay}"
                                                    FontSize="{x:Bind helpers:FontSizeHelper.SettingsSmallInitialFontSize}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="ConfirmRecycleBinToggle"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Toggled="GenericSetting_Toggled" />
                                </Grid>

                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- =========================================================
                         关于我们
                         ========================================================= -->
                    <StackPanel x:Name="AboutSection" Spacing="18" Visibility="Collapsed">
                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('关于我们'), Mode=OneWay}" FontSize="{x:Bind helpers:FontSizeHelper.SettingsTitleInitialFontSize}" FontWeight="SemiBold" />
                        <Border Padding="16" CornerRadius="8" BorderThickness="0.6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="BlockBox Program File Manager" FontSize="{x:Bind helpers:FontSizeHelper.SettingsTitleInitialFontSize}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind VersionText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button x:Name="CheckUpdatesButton"
                                        Tag="SkipForeground"
                                        Content="{x:Bind helpers:LanguageService.Translate('检查更新'), Mode=OneWay}"
                                        helpers:PressAnimationHelper.EnableBounce="True"
                                        Width="110"
                                        Height="36"
                                        Opacity="1"
                                        Style="{StaticResource CustomAddButtonStyle}"
                                        Background="{x:Bind PrimaryButtonBackground, Mode=OneWay}"
                                        CornerRadius="17" HorizontalAlignment="Left"
                                        Click="CheckUpdatesButton_Click" />
                                <HyperlinkButton x:Name="WebsiteButton" Content="{x:Bind helpers:LanguageService.Translate('官网 / GitHub'), Mode=OneWay}" NavigateUri="https://github.com/" />
                                <Button x:Name="FeedbackButton"
                                        Tag="SkipForeground"
                                        Content="{x:Bind helpers:LanguageService.Translate('反馈入口'), Mode=OneWay}"
                                        helpers:PressAnimationHelper.EnableBounce="True"
                                        Width="110"
                                        Height="36"
                                        Opacity="1"
                                        Style="{StaticResource CustomAddButtonStyle}"
                                        Background="{x:Bind PrimaryButtonBackground, Mode=OneWay}"
                                        CornerRadius="17" HorizontalAlignment="Left"
                                        Click="FeedbackButton_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
                <Grid x:Name="SettingsScrollBarTrack" Grid.Column="1" Margin="1,4,1,4"
                      Opacity="0" IsHitTestVisible="False"
                      SizeChanged="SettingsScrollBarTrack_SizeChanged"
                      PointerPressed="SettingsScrollBarTrack_PointerPressed"
                      PointerMoved="SettingsScrollBarThumb_PointerMoved"
                      PointerReleased="SettingsScrollBarThumb_PointerReleased"
                      PointerCaptureLost="SettingsScrollBarThumb_PointerCaptureLost">
                    <Border Background="Transparent" CornerRadius="4"/>
                    <Border x:Name="SettingsScrollBarThumb" Height="24" VerticalAlignment="Top"
                            Background="Transparent" CornerRadius="4"
                            PointerPressed="SettingsScrollBarThumb_PointerPressed"/>
            </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
