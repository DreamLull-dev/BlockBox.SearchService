                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('分类排序'), Mode=OneWay}" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CategorySortComboBox" Grid.Column="1" MinWidth="120" 
                                              
                                          CornerRadius="15"
                                              Height="32" SelectionChanged="ComboSetting_SelectionChanged">
                                        <ComboBoxItem Content="{x:Bind helpers:LanguageService.Translate('自定义顺序'), Mode=OneWay}" />
                                        <ComboBoxItem Content="{x:Bind helpers:LanguageService.Translate('名称升序'), Mode=OneWay}" />
                                    </ComboBox>
                                </Grid>
                                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('显示分区名称'), Mode=OneWay}" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="CategorySeparatorToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="GenericSetting_Toggled" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- =========================================================
                         通用
                         ========================================================= -->
                    <StackPanel x:Name="GeneralSection" Spacing="18" Visibility="Collapsed">
                        <TextBlock Text="{x:Bind helpers:LanguageService.Translate('通用'), Mode=OneWay}" FontSize="{x:Bind helpers:FontSizeHelper.SettingsTitleInitialFontSize}" FontWeight="SemiBold" />

                        <!-- 语言 / 地区 -->
                        <Border Padding="16" CornerRadius="8" BorderThickness="0.6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="0">
                                <TextBlock Text="{x:Bind helpers:LanguageService.Translate('语言 / 地区'), Mode=OneWay}" FontSize="{x:Bind helpers:FontSizeHelper.SettingsTitleInitialFontSize}" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('界面语言'), Mode=OneWay}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="LanguageComboBox"
                                              Width="140" Height="32" CornerRadius="15"
                                              Opacity="1" Background="White"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="LanguageComboBox_SelectionChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 字体 -->
                        <Border Padding="16" CornerRadius="8" BorderThickness="0.6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="0">
                                <TextBlock Text="{x:Bind helpers:LanguageService.Translate('字体'), Mode=OneWay}" FontSize="{x:Bind helpers:FontSizeHelper.SettingsTitleInitialFontSize}" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind helpers:LanguageService.Translate('字体大小'), Mode=OneWay}" VerticalAlignment="Center"/>
