<Window
    x:Class="BlockBox.Views.ExcludedProgramsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BlockBox.Models"
    Title="排除项">
<Grid x:Name="RootGrid" Padding="20,28,20,20" RowSpacing="14" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="排除项" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="CountText" Tag="SkipLocalization" FontSize="14" Opacity="0.75" />
        </StackPanel>
        <ListView x:Name="EntriesList" Grid.Row="1" SelectionMode="Multiple"
                  SelectionChanged="EntriesList_SelectionChanged"
                  ContainerContentChanging="EntriesList_ContainerContentChanging">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ShortcutItem">
                    <Grid Padding="8,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="36" Height="36" VerticalAlignment="Center">
                            <FontIcon x:Name="EntryIcon" Glyph="{x:Bind DisplayGlyph}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="EntryThumbnail" Width="36" Height="36" Stretch="Uniform" Visibility="Collapsed" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" Tag="SkipLocalization" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind TargetPath}" Tag="SkipLocalization" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="RemoveButton" Content="取消排除项" MinWidth="120" Height="32" CornerRadius="15" Click="RemoveButton_Click" />
            <Button Content="关闭" MinWidth="108" Height="32" CornerRadius="15" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
