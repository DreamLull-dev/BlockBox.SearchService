<Window
    x:Class="BlockBox.Views.TextInputWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="">
<Grid x:Name="RootGrid" Padding="24" RowSpacing="14" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
          <TextBox x:Name="InputBox"
                    Height="32"
                   Padding="10,7,7,7"
                   BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                   BorderThickness="1"
                   CornerRadius="15"
                   MaxLength="60" KeyDown="InputBox_KeyDown" >
            <TextBox.Resources>
              <!-- 取消边框 -->
              <Thickness x:Key="TextControlBorderThemeThicknessFocused">0.4</Thickness>
              <Thickness x:Key="TextControlBorderThemeThickness">0.4</Thickness>

              <!-- ⚠️ 取消各种状态下的背景色（全部透明） -->
              <SolidColorBrush x:Key="TextControlBackground" Color="#B3FFFFFF"/>
              <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#B3FFFFFF"/>
              <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#B3FFFFFF"/>
              <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#B3FFFFFF"/>

              <!-- ⚠️ 取消各种状态下的边框色（全部透明） -->
              <SolidColorBrush x:Key="TextControlBorderBrush" Color="#20000000"/>
              <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#20000000"/>
              <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#20000000"/>
              <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#20000000"/>
            </TextBox.Resources>
          </TextBox>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" 
                    Width="80"
                    Height="32"
                    CornerRadius="15"
                    Click="CancelButton_Click" />
            <Button x:Name="SaveButton"
                    Width="80"
                    Height="32"
                    CornerRadius="15"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
