<Window
    x:Class="BlockBox.Views.ShortcutPropertiesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="文件属性">
<Grid x:Name="RootGrid" Padding="24,28,24,20" RowSpacing="16" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="文件属性" FontSize="20" FontWeight="SemiBold" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Grid Width="40" Height="40">
                        <FontIcon x:Name="FileIcon" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="FileImage" Width="40" Height="40" Stretch="Uniform" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="FileNameText" Tag="SkipLocalization" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="CustomNameText" Tag="SkipLocalization" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="修改名称"
                    MinWidth="90" Height="32"
                    CornerRadius="15" Click="RenameButton_Click" />
                </Grid>
                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <TextBlock x:Name="AddedText" Tag="SkipLocalization" TextWrapping="Wrap" />
                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <TextBlock x:Name="CreatedText" Tag="SkipLocalization" TextWrapping="Wrap" />
                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <TextBlock x:Name="ModifiedText" Tag="SkipLocalization" TextWrapping="Wrap" />
                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <TextBlock x:Name="LocationText" Tag="SkipLocalization" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <TextBlock x:Name="BackupText" Tag="SkipLocalization" TextWrapping="Wrap" />
                <Rectangle Height="0.5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <TextBlock x:Name="SizeText" Tag="SkipLocalization" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="删除"
                    MinWidth="90" Height="32"
                    CornerRadius="15"
                    Click="DeleteButton_Click" />
            <Button x:Name="OpenBackupButton" Content="打开备份位置"
                    MinWidth="120" Height="32"
                    CornerRadius="15"
                    Click="OpenBackupButton_Click" />
            <Button Content="确定"
                    MinWidth="90" Height="32"
                    CornerRadius="15"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
