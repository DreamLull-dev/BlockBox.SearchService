<Window
    x:Class="BlockBox.Views.StartupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:BlockBox.Helpers"
    Title="BlockBox">
<Grid x:Name="RootGrid" Background="#10FFFFFF">
        <Border Width="380" Padding="36" CornerRadius="12"
                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="0"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <Image Source="ms-appx:///Assets/StoreLogo.png" Width="72" Height="72"
                       Stretch="Uniform" HorizontalAlignment="Center" />
                <TextBlock Text="BlockBox" FontSize="26" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <ProgressRing IsActive="True" Width="30" Height="30"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="正在加载..." FontSize="14"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
