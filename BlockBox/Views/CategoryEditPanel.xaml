<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BlockBox.Views.CategoryEditPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:BlockBox.Controls"
    xmlns:helpers="using:BlockBox.Helpers"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Padding="24" RowSpacing="16" MaxWidth="720"
          HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- ⭐ 标题 -->
            <RowDefinition Height="Auto"/>
            <!-- 名称 -->
            <RowDefinition Height="Auto"/>
            <!-- 图标 -->
            <RowDefinition Height="Auto"/>
            <!-- 分区 -->
            <RowDefinition Height="Auto"/>
            <!-- 类型 -->
            <RowDefinition Height="*"/>
            <!-- 占位 -->
            <RowDefinition Height="Auto"/>
            <!-- 按钮 -->
        </Grid.RowDefinitions>

        <!-- ⭐ 标题 -->
        <TextBlock x:Name="HeaderText" Grid.Row="0"
                   Text="{x:Bind helpers:LanguageService.Translate('新建分类'), Mode=OneWay}" FontSize="{x:Bind helpers:FontSizeHelper.DialogTitleFontSize}" FontWeight="SemiBold"
                   Margin="0,0,0,4"/>

        <!-- 分类名称 -->
        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="{x:Bind helpers:LanguageService.Translate('分类名称'), Mode=OneWay}" FontSize="{x:Bind helpers:FontSizeHelper.DialogBodyFontSize}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBox x:Name="NameBox"
                     Width="248"
                     BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                     BorderThickness="1"
                     
                     Padding="10,6,0,0"
                     Height="30"
                     VerticalContentAlignment="Center"
                     CornerRadius="8"
                     PlaceholderText="{x:Bind helpers:LanguageService.Translate('比如：开发工具'), Mode=OneWay}"
                     MaxLength="20">
                <TextBox.Resources>
                    <!-- 取消边框 -->
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0.4</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThickness">0.4</Thickness>

                    <!-- ⚠️ 取消各种状态下的背景色（全部透明） -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="#B3FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#B3FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#B3FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#B3FFFFFF"/>

                    <!-- ⚠️ 取消各种状态下的边框色（全部透明） -->
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#20000000"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#20000000"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#20000000"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#20000000"/>
                </TextBox.Resources>
            </TextBox>
            
        </StackPanel>

        <!-- 图标选择 -->
        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Text="{x:Bind helpers:LanguageService.Translate('图标'), Mode=OneWay}" FontSize="{x:Bind helpers:FontSizeHelper.DialogBodyFontSize}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="40" Height="40"
                        CornerRadius="6"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <FontIcon x:Name="PreviewIcon" Glyph="&#xE71D;" FontSize="18"/>
                </Border>
                <ComboBox x:Name="IconPicker"
                          MinWidth="100"
                          Height="34"
                          Margin="0,2.4,0,0"
                          CornerRadius="16"
                          FontSize="{x:Bind helpers:FontSizeHelper.DialogControlFontSize}"
                          PlaceholderText="{x:Bind helpers:LanguageService.Translate('选择图标'), Mode=OneWay}"
                            BorderThickness="0.6" 
                          SelectionChanged="IconPicker_SelectionChanged"/>
            </StackPanel>
        </StackPanel>

        <!-- 所属分区 -->
        <StackPanel Grid.Row="3" Spacing="6">
            <TextBlock Text="{x:Bind helpers:LanguageService.Translate('所属分区'), Mode=OneWay}" FontSize="{x:Bind helpers:FontSizeHelper.DialogBodyFontSize}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <ComboBox x:Name="GroupPicker"
                     MaxHeight="32"
                     MinHeight="24"
                            BorderThickness="0.6" 
                           CornerRadius="15" Width="130" HorizontalAlignment="Left"
                      SelectionChanged="GroupPicker_SelectionChanged"/>
            <TextBox x:Name="PartitionNameBox"
                     Width="248"
                     BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                     BorderThickness="1"
                     Padding="10,7,0,0"
                     Height="30"
                     VerticalContentAlignment="Center"
                     CornerRadius="8"
                     MaxLength="20"
                     IsReadOnly="True"
                     PlaceholderText="{x:Bind helpers:LanguageService.Translate('请输入分区名'), Mode=OneWay}">
                <TextBox.Resources>
                    <!-- 取消边框 -->
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>

                    <!-- ⚠️ 取消各种状态下的背景色（全部透明） -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="#B3FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#B3FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#B3FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#B3FFFFFF"/>

                    <!-- ⚠️ 取消各种状态下的边框色（全部透明） -->
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#40000000"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#40000000"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#40000000"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#40000000"/>
                </TextBox.Resources>
            </TextBox>

        </StackPanel>

        <!-- 存放的文件类型 -->
        <StackPanel Grid.Row="4" Spacing="6">
            <TextBlock Text="{x:Bind helpers:LanguageService.Translate('存放的文件类型'), Mode=OneWay}" FontSize="{x:Bind helpers:FontSizeHelper.DialogBodyFontSize}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="KindPicker"
                            BorderThickness="0.6" 
                          CornerRadius="15" Width="110" HorizontalAlignment="Left"
                          SelectionChanged="KindPicker_SelectionChanged"/>
                <controls:ScrollbarCursorTextBox x:Name="CustomExtBox"
                         Style="{StaticResource NoClearButtonTextBoxStyle}"
                         PlaceholderText=".psd,.ai,.sketch"
                         Width="130"
                         BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                         BorderThickness="1"
                         TextWrapping="NoWrap"
                         ScrollViewer.HorizontalScrollMode="Enabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         FontSize="12"
                         Padding="5,7,5,0"
                         VerticalContentAlignment="Center"
                         IsReadOnly="True"/>
            </StackPanel>
        </StackPanel>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Content="{x:Bind helpers:LanguageService.Translate('取消'), Mode=OneWay}" 
                    BorderThickness="0.6" 
                    Height="32"
                    CornerRadius="15"
                    Click="Cancel_Click" MinWidth="78"/>
            <Button x:Name="ConfirmBtn"
                    helpers:PressAnimationHelper.EnableBounce="True"
                    Tag="SkipForeground"
                    Content="{x:Bind helpers:LanguageService.Translate('创建'), Mode=OneWay}"
                    CornerRadius="15"
                    Height="32"
                    Style="{StaticResource CustomAddButtonStyle}"
                    Click="Confirm_Click"
                    MinWidth="88"/>
        </StackPanel>
    </Grid>
</UserControl>