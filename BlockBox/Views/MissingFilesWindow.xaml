<Window
    x:Class="BlockBox.Views.MissingFilesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="">
<Grid x:Name="RootGrid" Padding="24" RowSpacing="14" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="SummaryText" Grid.Row="1" TextWrapping="Wrap" />
        <ListView x:Name="MissingItemsList" Grid.Row="2" SelectionMode="None" />
        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock x:Name="BackupWarningText" TextWrapping="Wrap" />
            <TextBlock x:Name="InstructionsText" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="LaterButton"
                    MinWidth="90" Height="32"
                    CornerRadius="15" Click="LaterButton_Click" />
            <Button x:Name="UseBackupButton"
                    MinWidth="90" Height="32"
                    CornerRadius="15" Click="UseBackupButton_Click" />
            <Button x:Name="DeleteButton"
                    MinWidth="90" Height="32"
                    CornerRadius="15" Click="DeleteButton_Click" />
        </StackPanel>
    </Grid>
</Window>
