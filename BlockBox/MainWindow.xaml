<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BlockBox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlockBox"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:BlockBox.Models"
    xmlns:helpers="using:BlockBox.Helpers"
    xmlns:views="using:BlockBox.Views"
    mc:Ignorable="d"
    Title="BlockBox">

    <Grid x:Name="MainWindowRoot" helpers:FontSizeHelper.ApplyGlobalFontScale="True"
         helpers:FontSizeHelper.InitialFontSize="{x:Bind helpers:FontSizeHelper.ContentInitialFontSize}">
        <!-- 0. 动态背景层 -->
        <Image x:Name="BgImage" Stretch="UniformToFill" Visibility="Collapsed" Opacity="0.8"/>
        <MediaPlayerElement x:Name="BgMediaPlayer" Stretch="UniformToFill" AutoPlay="True" Visibility="Collapsed"/>

        <!-- 1. 半透明遮罩层 -->
        <Border x:Name="OverlayMask" Background="#80000000" />
        
        <!-- 2. 主界面 UI 层 -->
        <Grid x:Name="MainUIView" 
              CornerRadius="0,0,0,0"
              Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <!-- 拖拽区 -->
                <RowDefinition Height="*" />
                <!-- 内容区 -->
            </Grid.RowDefinitions>
            <!-- 拖拽区 -->
        <Grid Grid.Row="0" Tag="SkipGlobalFontSize">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border x:Name="TitleBarDragRegion"
                Grid.Column="0"
                Background="Transparent"
                Height="32"
                    Margin="232,0,0,0"
                VerticalAlignment="Stretch" />
                <!-- Logo：只在侧边栏展开时显示 -->
                <StackPanel x:Name="TitleBarLogo"
                Grid.Column="0"
                Orientation="Horizontal"
                IsHitTestVisible="False"
                Margin="6,0,0,0"
                VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/StoreLogo.png"
               Width="20" Height="20"
               Stretch="Uniform" />
                                    <TextBlock x:Name="TitleBarLogoText" Text="BlockBox" FontSize="12" FontWeight="SemiBold"
                    Tag="SkipGlobalFontSize"
                   Padding="5,0,0,0"
                   VerticalAlignment="Center"
                   Foreground="White" />
                </StackPanel>
                <!-- 菜单栏：左边界跟随侧边栏 -->
                <Border x:Name="MenuBarHost"
        Grid.Column="0"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Margin="232,0,0,0">
                    <Border.Resources>
                        <MenuFlyout x:Name="FileMenuFlyout"
                    Placement="BottomEdgeAlignedLeft"
                    Opened="TitleBarMenuFlyout_Opened"
                    Closed="TitleBarMenuFlyout_Closed">
                            <MenuFlyoutItem x:Name="FileNewCategoryMenuItem" Text="{x:Bind helpers:LanguageService.Translate('新建分类'), Mode=OneWay}" Click="MenuNewCategory_Click"/>
                            <MenuFlyoutItem x:Name="FileNewTabMenuItem" Text="{x:Bind helpers:LanguageService.Translate('新建标签页'), Mode=OneWay}" Click="MenuNewTab_Click"/>
                            <MenuFlyoutItem Text="{x:Bind helpers:LanguageService.Translate('最近访问'), Mode=OneWay}" Click="MenuRecent_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="{x:Bind helpers:LanguageService.Translate('回收站'), Mode=OneWay}" Click="MenuRecycleBin_Click"/>
                            <MenuFlyoutItem Text="{x:Bind helpers:LanguageService.Translate('排除项'), Mode=OneWay}" Click="MenuExcludedPrograms_Click"/>
                            <MenuFlyoutItem Text="{x:Bind helpers:LanguageService.Translate('失效文件'), Mode=OneWay}" Click="MenuMissingFiles_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="{x:Bind helpers:LanguageService.Translate('退出到托盘'), Mode=OneWay}" Click="MenuHideToTray_Click"/>
                            <MenuFlyoutItem Text="{x:Bind helpers:LanguageService.Translate('结束进程'), Mode=OneWay}" Click="MenuExitApp_Click"/>
                        </MenuFlyout>

                        <MenuFlyout x:Name="EditMenuFlyout"
                    Placement="BottomEdgeAlignedLeft"
                    Opened="TitleBarMenuFlyout_Opened"
                    Closed="TitleBarMenuFlyout_Closed">
                            <MenuFlyoutItem x:Name="EditAddMenuItem" Text="{x:Bind helpers:LanguageService.Translate('添加'), Mode=OneWay}" Click="MenuAdd_Click"/>
                            <MenuFlyoutItem x:Name="EditSelectAllMenuItem" Text="{x:Bind helpers:LanguageService.Translate('全选'), Mode=OneWay}" Click="MenuSelectAll_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Name="EditCutMenuItem" Text="{x:Bind helpers:LanguageService.Translate('剪切'), Mode=OneWay}" Click="MenuCut_Click"/>
                            <MenuFlyoutItem x:Name="EditCopyMenuItem" Text="{x:Bind helpers:LanguageService.Translate('复制'), Mode=OneWay}" Click="MenuCopy_Click"/>
                            <MenuFlyoutItem x:Name="EditPasteMenuItem" Text="{x:Bind helpers:LanguageService.Translate('粘贴'), Mode=OneWay}" Click="MenuPaste_Click"/>
                            <MenuFlyoutItem x:Name="EditRenameMenuItem" Text="{x:Bind helpers:LanguageService.Translate('重命名'), Mode=OneWay}" Click="MenuRename_Click"/>
                            <MenuFlyoutItem x:Name="EditDeleteMenuItem" Text="{x:Bind helpers:LanguageService.Translate('删除'), Mode=OneWay}" Click="MenuDelete_Click"/>
                            <MenuFlyoutItem x:Name="EditFavoriteMenuItem" Text="{x:Bind helpers:LanguageService.Translate('收藏'), Mode=OneWay}" Click="MenuFavorite_Click"
                            />
                        </MenuFlyout>

                        <MenuFlyout x:Name="ViewMenuFlyout"
                    Placement="BottomEdgeAlignedLeft"
                    Opened="TitleBarMenuFlyout_Opened"
                    Closed="TitleBarMenuFlyout_Closed" />

                        <MenuFlyout x:Name="HelpMenuFlyout"
                    Placement="BottomEdgeAlignedLeft"
                    Opened="TitleBarMenuFlyout_Opened"
                    Closed="TitleBarMenuFlyout_Closed">
                            <MenuFlyoutItem Text="{x:Bind helpers:LanguageService.Translate('操作手册'), Mode=OneWay}" IsEnabled="False"/>
                            <MenuFlyoutItem Text="{x:Bind helpers:LanguageService.Translate('反馈'), Mode=OneWay}" IsEnabled="False"/>
                            <MenuFlyoutItem Text="{x:Bind helpers:LanguageService.Translate('检查更新'), Mode=OneWay}" IsEnabled="False"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="{x:Bind helpers:LanguageService.Translate('关于 Block Box'), Mode=OneWay}" Click="MenuAbout_Click"/>
                        </MenuFlyout>
                    </Border.Resources>

                    <StackPanel x:Name="TitleBarMenuButtons" Orientation="Horizontal" Spacing="0">
                        <Button Content="{x:Bind helpers:LanguageService.Translate('文件'), Mode=OneWay}" Tag="File"
                Style="{StaticResource TitleBarMenuButtonStyle}"
                Click="TitleBarMenuButton_Click"
                PointerEntered="TitleBarMenuButton_PointerEntered"/>
                        <Button Content="{x:Bind helpers:LanguageService.Translate('编辑'), Mode=OneWay}" Tag="Edit"
                Style="{StaticResource TitleBarMenuButtonStyle}"
                Click="TitleBarMenuButton_Click"
                PointerEntered="TitleBarMenuButton_PointerEntered"/>
                        <Button Content="{x:Bind helpers:LanguageService.Translate('视图'), Mode=OneWay}" Tag="View"
                Style="{StaticResource TitleBarMenuButtonStyle}"
                Click="TitleBarMenuButton_Click"
                PointerEntered="TitleBarMenuButton_PointerEntered"/>
                        <Button Content="{x:Bind helpers:LanguageService.Translate('帮助'), Mode=OneWay}" Tag="Help"
                Style="{StaticResource TitleBarMenuButtonStyle}"
                Click="TitleBarMenuButton_Click"
                PointerEntered="TitleBarMenuButton_PointerEntered"/>
                    </StackPanel>
                </Border>
                <!--时钟-->
                <TextBlock x:Name="TitleBarClock" Grid.Column="1" Margin="0,0,140,0" VerticalAlignment="Center"
                       FontSize="12" Tag="SkipGlobalFontSize" Foreground="White" IsHitTestVisible="False"/>
        </Grid>
            <Border x:Name="ContentAreaBorder" Grid.Row="1"
                    Margin="3,0,3,3"
                    CornerRadius="8,8,8,8"
                    Background="Transparent">
            <Grid x:Name="ContentAreaRoot">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid x:Name='LeftBGcolor' Width="232" Padding="2.4,2.4,0,2" Background="Black"
                  HorizontalAlignment="Left"
                  CornerRadius="0,0,0,0">
                    <!-- ================= 2.1 左侧菜单 ================= -->
                    <Grid x:Name="SidebarGrid"
                          helpers:FontSizeHelper.InitialFontSize="{x:Bind helpers:FontSizeHelper.SidebarInitialFontSize}"
      Grid.Column="0" 
      Width="229.6"
                          CornerRadius="6"
                          Margin="-1"
                          BorderThickness="1.5"
                          BorderBrush="Transparent"
          HorizontalAlignment="Left"
      Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- 背景层：视频（最底层） -->
                        <MediaPlayerElement x:Name="SidebarBgVideo"
                    Grid.RowSpan="3"
                    Stretch="UniformToFill"
                    AutoPlay="False"
                    AreTransportControlsEnabled="False"
                    Background="Transparent"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"/>

                        <!-- 背景层：纯色 / 图片（图片右下角锚点） -->
                        <Border x:Name="SidebarBgBorder"
        Grid.RowSpan="3"
        CornerRadius="0,8,0,0"
        IsHitTestVisible="False">
                            <Border.Background>
                                <ImageBrush x:Name="SidebarBgImageBrush"
                    Stretch="UniformToFill"
                    AlignmentX="Right"
                    AlignmentY="Bottom"/>
                            </Border.Background>
                        </Border>
                        <!-- 顶部添加按钮（去掉了固定的宽高，改为自适应+最小高度） -->
                        <Button x:Name="SidebarAddBt"
                            helpers:PressAnimationHelper.EnableBounce="True"
            Margin="9" 
            Width="211.6"
            MinHeight="37"
            CornerRadius="18.5"
            HorizontalAlignment="Stretch" 
            Style="{StaticResource CustomAddButtonStyle}"
            Click="SidebarAdd_Click">
                            <Button.RenderTransform>
                                <TranslateTransform X="0" />
                            </Button.RenderTransform>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="AddBtnIcon" Glyph="&#xE710;" FontSize="14"/>
                                <TextBlock x:Name="AddBtnText" 
                                       Text="{x:Bind helpers:LanguageService.Translate('添加'), Mode=OneWay}" 
                                       Opacity="1"/>
                            </StackPanel>
                        </Button>

                        <!-- 菜单列表（去掉写死的宽高，用MinHeight防止字体变大后遮挡） -->
                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                            </Grid.ColumnDefinitions>
                        <ListView x:Name="NavMenuList" 
      Grid.Column="0"
      Loaded="NavMenuList_Loaded"
      Margin="0,0,0,0" 
      SelectionMode="Single"
      SelectionChanged="NavMenuList_SelectionChanged"
      RightTapped="NavMenuList_RightTapped"
      ScrollViewer.HorizontalScrollMode="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      ScrollViewer.VerticalScrollBarVisibility="Hidden"
      ScrollViewer.VerticalScrollMode="Auto">
                            <ListView.Resources>

                                <Style x:Key="NavItemStyle" TargetType="ListViewItem"
       BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="MinHeight" Value="36"/>
                                    <Setter Property="Height" Value="NaN"/>
                                    <Setter Property="Padding" Value="12,0,0,0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                    <Setter Property="IsHitTestVisible" Value="True"/>
                                </Style>

                                <Style x:Key="NavSectionHeaderStyle" TargetType="ListViewItem"
       BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="MinHeight" Value="24"/>
                                    <Setter Property="Height" Value="32"/>
                                    <Setter Property="Padding" Value="12,0,12,0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                    <Setter Property="IsHitTestVisible" Value="True"/>
                                </Style>

                                <Style x:Key="NavSeparatorStyle" TargetType="ListViewItem"
       BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="MinHeight" Value="12"/>
                                    <Setter Property="Height" Value="12"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                </Style>
                            </ListView.Resources>
                            <ListView.RenderTransform>
                                <TranslateTransform X="0" />
                            </ListView.RenderTransform>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Category">
                                    <Grid x:Name="CategoryRootGrid"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      MinHeight="36"
                                          CornerRadius="5"
                                      helpers:PressAnimationHelper.EnableBounce="True"
                                      Padding="0,0"
                                      Background="#02FFFFFF">
                                        <Border x:Name="CategoryRootBackground"
                                                helpers:PressAnimationHelper.EnableBounce="True"
                                            CornerRadius="6"
                                            Background="Transparent"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch" />
                                        <!-- 分类项 -->
                                        <StackPanel x:Name="CategoryPanel" Orientation="Horizontal" Spacing="12"
              Visibility="{x:Bind ContentVisibility, Mode=OneWay}">
                                            <FontIcon x:Name="CategoryIcon"
              Glyph="{x:Bind IconGlyph, Mode=OneWay}"
              Width="20"
                                      Foreground="{ThemeResource TextFillColorSidebarBrush}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"/>
                                             <TextBlock x:Name="CategoryText"
                Text="{x:Bind DisplayName, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSidebarBrush}"
               Opacity="1"
                VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid x:Name="SeparatorRoot"
      Visibility="{x:Bind SeparatorVisibility}">
                                            <Border x:Name="SeparatorLine"
            Height="1"
                                                Margin="12,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            Visibility="{x:Bind SeparatorLineVisibility}"/>
                                            <Button x:Name="SharedCategoriesHeader"
                                                    Tag="SkipForeground"
                                                    Height="28"
                                                    HorizontalAlignment="Stretch"
                                                    Padding="0,0,0,0"
                                                    Margin="0,-4,0,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Click="PartitionHeader_Click"
                                                    Visibility="{x:Bind SectionHeaderVisibility}">
                                                <Button.Resources>
                                                    <!-- ⭐ 关掉悬浮背景 -->
                                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>

                                                    <!-- ⭐ 关掉文字变色（悬浮、按下、禁用都不变） -->
                                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                         Color="{ThemeResource TextFillColorSecondary}"/>
                                                    <SolidColorBrush x:Key="ButtonForegroundPressed"
                         Color="{ThemeResource TextFillColorSecondary}"/>
                                                    <SolidColorBrush x:Key="ButtonForegroundDisabled"
                         Color="{ThemeResource TextFillColorSecondary}"/>
                                                    <SolidColorBrush x:Key="ButtonForeground"
                         Color="{ThemeResource TextFillColorSecondary}"/>

                                                    <!-- ⭐ 边框也透明（有些主题会画一条） -->
                                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                                                </Button.Resources>
                                                <StackPanel x:Name="SectionHeaderPanel"
                                                            Orientation="Horizontal"
                                                            Spacing="8"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                    <StackPanel.RenderTransform>
                                                        <TranslateTransform X="0" />
                                                    </StackPanel.RenderTransform>
                                                    <TextBlock x:Name="SectionHeaderLabel" 
                                                               Padding="0,0,0,0"
                                                               Width="178"
                                                                Foreground="{ThemeResource TextFillColorSidebarBrush}"
                                                                FontSize="{x:Bind helpers:FontSizeHelper.ContentSmallFontSize}" VerticalAlignment="Center"/>
                                                    <FontIcon  x:Name="SectionHeaderArrow" Glyph="{x:Bind SectionHeaderGlyph, Mode=OneWay}" FontSize="9"
                                                              
                                                               Foreground="{ThemeResource TextFillColorSidebarBrush}"
                                                              VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                            <Grid x:Name="NavScrollBarTrack" Grid.Column="1" Margin="1,4,1,4"
                                  Opacity="0" IsHitTestVisible="False"
                                  PointerPressed="CustomScrollBarTrack_PointerPressed">
                                <Border x:Name="NavScrollBarTrackFill" Background="Transparent" Opacity="0" CornerRadius="4"/>
                                <Border x:Name="NavScrollBarThumb" Height="24" VerticalAlignment="Top"
                                        Background="Transparent" CornerRadius="4"
                                        Opacity="0.9" PointerPressed="CustomScrollBarThumb_PointerPressed"
                                        PointerMoved="CustomScrollBarThumb_PointerMoved"
                                        PointerReleased="CustomScrollBarThumb_PointerReleased"
                                        PointerCaptureLost="CustomScrollBarThumb_PointerCaptureLost"/>
                            </Grid>
                        </Grid>

                        <!-- 底部操作区（Canvas 绝对定位，方便做平移动画） -->
                        <Canvas x:Name="SidebarBottomCanvas"
        Grid.Row="2"
        Height="88"
        Margin="0,4,0,4"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Bottom">
                            <Button x:Name="SettingsButton"
            Canvas.Left="13"
            Canvas.Top="4"
             Width="36" Height="36"
                                CornerRadius="16"
                                Padding="0,0,0,0"
            Background="Transparent"
            BorderThickness="0"
             Foreground="{ThemeResource TextFillColorSidebarBrush}"
            ToolTipService.ToolTip="{x:Bind helpers:LanguageService.Translate('设置'), Mode=OneWay}"
            Click="SettingsButton_Click">
                                <Button.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Button.RenderTransform>
                                <FontIcon Glyph="&#xE713;" FontSize="16"/>
                            </Button>
                            <Button x:Name="ToggleSidebarButton"
            Canvas.Left="13"
            Canvas.Top="48"
             Width="36" Height="36"
                                CornerRadius="16"
                                Padding="0,0,0,0"
            Background="Transparent"
            BorderThickness="0"
             Foreground="{ThemeResource TextFillColorSidebarBrush}"
            ToolTipService.ToolTip="{x:Bind helpers:LanguageService.Translate('展开/收缩'), Mode=OneWay}"
            Click="ToggleSidebar_Click">
                                <FontIcon x:Name="ToggleSidebarIcon" Glyph="&#xE76B;" FontSize="16"/>
                            </Button>
                        </Canvas>
                    </Grid>
                </Grid>



                <!-- ================= 2.2 右侧主区域 ================= -->
                <Grid x:Name="MainContentArea" Grid.Column="1" Background="Transparent"
                      
                      helpers:FontSizeHelper.ApplyGlobalFontScale="True"
                      helpers:FontSizeHelper.InitialFontSize="{x:Bind helpers:FontSizeHelper.ContentInitialFontSize}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 标签栏 -->
                    <Grid x:Name="TabBarGrid" Grid.Row="0" Padding="0" Height="42"
                          
                          helpers:FontSizeHelper.InitialFontSize="{x:Bind helpers:FontSizeHelper.TabInitialFontSize}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <!-- 展开按钮 -->
                            <ColumnDefinition Width="*" />
                            <!-- TabView，占满剩余 -->
                            <ColumnDefinition Width="Auto" />
                            <!-- 工作模式 -->
                        </Grid.ColumnDefinitions>

                        <!-- 展开按钮 -->
                        <Button x:Name="ExpandButton" 
                                BorderThickness="0.6"
                            helpers:PressAnimationHelper.EnableBounce="True"
                            Grid.Column="0" 
                            Padding="3" 
                            Foreground="{ThemeResource TextFillColorTabBarBrush}"
                            VerticalAlignment="Center" 
                            Margin="8,0,0,0"
                            Click="ExpandButton_Click">
                            <FontIcon Glyph="&#xE70D;" FontSize="14" />
                        </Button>
                        <!-- ⚠️ 关键：Canvas 放在 TabView 前面，渲染在底层 -->
                        <Canvas x:Name="TabIndicatorCanvas"
        Grid.Column="1"
        IsHitTestVisible="False"
        VerticalAlignment="Top"
        Height="42.5">
                            <Canvas.Clip>
                                <RectangleGeometry Rect="0,0,10000,42.5"/>
                            </Canvas.Clip>
                            <Path x:Name="SlidingIndicator"
          Stretch="None"
          Height="38"
          Margin="0,8,0,0"
          Visibility="Collapsed"
          Fill="{ThemeResource TabViewItemHeaderBackgroundSelected}"/>
                        </Canvas>
                        <!-- TabView：保持 SizeToContent，统一宽度由代码计算后显式应用到各标签 -->
                        <TabView x:Name="MyTabView"
                                 Tag="SkipForeground"
                             Grid.Column="1"
                             HorizontalAlignment="Stretch"
                             TabItemsSource="{x:Bind TabItems}"
                             TabWidthMode="SizeToContent"
                             AddTabButtonClick="TabView_AddTabButtonClick"
                             IsAddTabButtonVisible="False"
                             TabCloseRequested="TabView_TabCloseRequested"
                              SelectionChanged="MyTabView_SelectionChanged"
                              Loaded="MyTabView_Loaded"
                             CanReorderTabs="False">

                            <TabView.TabItemTemplate>
                                <DataTemplate x:DataType="models:MyTabItem">
                                    <TabViewItem Header="{x:Bind}"               
                                             IsClosable="{x:Bind IsClosable}"
                                             Height="37"
                                             Loaded="TabViewItem_Loaded"
                                             helpers:PressAnimationHelper.EnableBounce="True"
                                             MaxWidth="152"
                                             MinWidth="60"
                                             Padding="0,-2,0,0"
                                             Style="{StaticResource EdgeTabViewItemStyle}">
                                        <TabViewItem.HeaderTemplate>
                                            <DataTemplate x:DataType="models:MyTabItem">
                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                Padding="4,0"
                                VerticalAlignment="Center">
                                                    <FontIcon Glyph="{x:Bind IconGlyph}"
                                  FontSize="{x:Bind helpers:FontSizeHelper.TabInitialFontSize}"
                                  VerticalAlignment="Center"/>
                                                    <TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}" Tag="SkipLocalization"
                                    FontSize="{x:Bind helpers:FontSizeHelper.TabInitialFontSize}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </TabViewItem.HeaderTemplate>
                                    </TabViewItem>
                                </DataTemplate>
                            </TabView.TabItemTemplate>

                            <!-- 用 TabStripFooter 自定义“+”按钮，它会自动垂直居中 -->
                            <TabView.TabStripFooter>
                                <Button x:Name="CustomAddButton"
                            helpers:PressAnimationHelper.EnableBounce="True"
                                    Margin="4,0,0,0"
                                    Style="{StaticResource TransparentAddButtonStyle}"
                                    Foreground="{ThemeResource TextFillColorTabBarBrush}"
                                    VerticalAlignment="Center"
                                    Click="CustomAddButton_Click">
                                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                </Button>
                            </TabView.TabStripFooter>
                        </TabView>

                        <Canvas x:Name="TabDragOverlay"
                                Grid.Column="1"
                                Height="42"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False">
                            <Canvas.Clip>
                                <RectangleGeometry Rect="0,0,10000,42" />
                            </Canvas.Clip>
                        </Canvas>

                        <!-- 工作模式 + 全局搜索入口 -->
                        <StackPanel x:Name="TabBarRightHost" Grid.Column="2"
                                    Orientation="Horizontal" VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <Button x:Name="ModeSwitcher"
                                helpers:PressAnimationHelper.EnableBounce="True"
                                BorderThickness="0.6"
                                MinWidth="100"
                                Height="30"
                                CornerRadius="15"
                                Margin="0,0,7,0"
                                Padding="18,4,5,4"
                                Foreground="{ThemeResource TextFillColorTabBarBrush}"
                                VerticalAlignment="Center"
                                FontSize="{x:Bind helpers:FontSizeHelper.ContentSmallFontSize}"
                                Click="ModeSwitcher_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="ModeSwitcherText" VerticalAlignment="Center"/>
                                    <FontIcon Glyph="&#xE70D;" FontSize="10"/>
                                </StackPanel>
                            </Button>
                            <!-- 关闭搜索窗体后渐入；宽度 0→40 的动画同时让 ModeSwitcher 左移、标签区收窄 -->
                            <Grid x:Name="SearchLauncherHost" Width="0" Opacity="0" Visibility="Collapsed"
                                  VerticalAlignment="Center" SizeChanged="SearchLauncherHost_SizeChanged">
                                <Button x:Name="SearchLauncherButton"
                                        Width="30" Height="30" CornerRadius="15" Padding="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,7,0" BorderThickness="0.6"
                                        Background="#14FFFFFF"
                                        Foreground="{ThemeResource TextFillColorTabBarBrush}"
                                        ToolTipService.ToolTip="{x:Bind helpers:LanguageService.Translate('全局搜索'), Mode=OneWay}"
                                        Click="SearchLauncher_Click">
                                    <FontIcon Glyph="&#xE721;" FontSize="13"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- 搜索栏与操作栏 -->
                    <Grid x:Name="ContentAreaBody" Grid.Row="1" Background="White" CornerRadius="5" Margin="2.3,0,2.3,3">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                    <!-- 内容区背景层：覆盖搜索栏与内容栏，位于它们下方 -->
                    <MediaPlayerElement x:Name="ContentBgVideo"
                                        Grid.RowSpan="2"
                                        Stretch="UniformToFill"
                                        AutoPlay="False"
                                        AreTransportControlsEnabled="False"
                                        Background="Transparent"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False" />
                            <Border x:Name="ContentBgBorder"
                            Grid.RowSpan="2"
                            IsHitTestVisible="False">
                                <Border.Background>
                                    <ImageBrush x:Name="ContentBgImageBrush"
                                        Stretch="UniformToFill"
                                        AlignmentX="Right"
                                        AlignmentY="Bottom" />
                                </Border.Background>
                            </Border>
                            <Grid Grid.Row="0" Padding="20,5,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- ============ 容器 1：搜索图标 + 搜索框 + 删除图标 ============ -->
                        <Border x:Name="SearchBoxBorder" Grid.Column="0"
                            MaxWidth="550"
            HorizontalAlignment="Left"
            CornerRadius="15"
            BorderThickness="0.6"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Padding="8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 搜索图标 -->
                                <FontIcon Grid.Column="0"
                      Glyph="&#xE721;"
                      FontSize="14"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"
                      Foreground="{ThemeResource TextFillColorTabBarBrush}"/>

                                <!-- 搜索框 -->
                                <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     PlaceholderText="{x:Bind helpers:LanguageService.Translate('搜索...'), Mode=OneWay}"
                                     GotFocus="SearchBox_GotFocus"
                                      FontSize="{x:Bind helpers:FontSizeHelper.ContentSmallFontSize}"
                                     Style="{StaticResource NoClearButtonTextBoxStyle}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{ThemeResource TextFillColorTabBarBrush}"
                                     PlaceholderForeground="{ThemeResource TextFillColorTabBarBrush}"
                                     Padding="0,0,0,0"
                                     Width="300"
                                     MinWidth="0"                      
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchBox_TextChanged">
                                    <TextBox.Resources>
                                        <!-- 取消边框 -->
                                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>

                                        <!-- ⚠️ 取消各种状态下的背景色（全部透明） -->
                                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>

                                        <SolidColorBrush x:Key="TextControlForeground" Color="{ThemeResource TextFillColorTabBar}"/>
                                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{ThemeResource TextFillColorTabBar}"/>
                                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{ThemeResource TextFillColorTabBar}"/>
                                        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{ThemeResource TextFillColorTabBar}"/>
                                        <!-- ⚠️ 取消各种状态下的边框色（全部透明） -->
                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                                    </TextBox.Resources>
                                </TextBox>
                                <Button x:Name="ClearSearchButton"
                                    helpers:PressAnimationHelper.EnableBounce="True"
                                    Grid.Column="2"
                                    Width="22" Height="22"
                                    Padding="0"
                                    Margin="4,0,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="11"
                                    VerticalAlignment="Center"
                                    Visibility="Visible"
                                    Click="ClearSearchButton_Click"
                                    ToolTipService.ToolTip="{x:Bind helpers:LanguageService.Translate('清空'), Mode=OneWay}">
                                    <FontIcon Glyph="&#xE711;" FontSize="11"
              Foreground="{ThemeResource TextFillColorTabBarBrush}"/>
                                </Button>

                            </Grid>
                        </Border>

                        <!-- ============ 容器 2：操作按钮区 ============ -->
                        <StackPanel Grid.Column="1"  
                                Orientation="Horizontal" Spacing="4"
                                    Height="32">
                            <StackPanel.Resources>
                                <Style TargetType="FontIcon">
                                    <Setter Property="FontSize" Value="17" />
                                </Style>
                            </StackPanel.Resources>
                            <Button x:Name="AddFileButton"
                            helpers:PressAnimationHelper.EnableBounce="True"
            ToolTipService.ToolTip="{x:Bind helpers:LanguageService.Translate('添加文件'), Mode=OneWay}"
            Style="{StaticResource ToolbarIconButtonStyle}"
                                BorderThickness="0"
            Foreground="{ThemeResource TextFillColorTabBarBrush}"
            Click="AddFileButton_Click">
                                <FontIcon Glyph="&#xE710;" />
                            </Button>
                            <Button x:Name="ToolbarCutButton"
                            helpers:PressAnimationHelper.EnableBounce="True"
        ToolTipService.ToolTip="{x:Bind helpers:LanguageService.Translate('剪切'), Mode=OneWay}"
            Style="{StaticResource ToolbarIconButtonStyle}" BorderThickness="0"
        Foreground="{ThemeResource TextFillColorTabBarBrush}"
        Click="ToolbarCut_Click">
                                <FontIcon Glyph="&#xE8C6;" />
                            </Button>
                            <Button x:Name="ToolbarCopyButton"
                            helpers:PressAnimationHelper.EnableBounce="True"
        ToolTipService.ToolTip="{x:Bind helpers:LanguageService.Translate('复制'), Mode=OneWay}"
            Style="{StaticResource ToolbarIconButtonStyle}" BorderThickness="0"
        Foreground="{ThemeResource TextFillColorTabBarBrush}"
        Click="ToolbarCopy_Click">
                                <FontIcon Glyph="&#xE8C8;" />
                            </Button>
                            <Button x:Name="ToolbarPasteButton"
                            helpers:PressAnimationHelper.EnableBounce="True"
        ToolTipService.ToolTip="{x:Bind helpers:LanguageService.Translate('粘贴'), Mode=OneWay}"
            Style="{StaticResource ToolbarIconButtonStyle}" BorderThickness="0"
        Foreground="{ThemeResource TextFillColorTabBarBrush}"
        Click="ToolbarPaste_Click">
                                <FontIcon Glyph="&#xE77F;" />
                            </Button>
                            <Button x:Name="ToolbarRenameButton"
                            helpers:PressAnimationHelper.EnableBounce="True"
        ToolTipService.ToolTip="{x:Bind helpers:LanguageService.Translate('重命名'), Mode=OneWay}"
            Style="{StaticResource ToolbarIconButtonStyle}" BorderThickness="0"
        Foreground="{ThemeResource TextFillColorTabBarBrush}"
        Click="ToolbarRename_Click">
                                <FontIcon Glyph="&#xE8AC;" />
                            </Button>
                            <Button x:Name="ToolbarDeleteButton"
                            helpers:PressAnimationHelper.EnableBounce="True"
        ToolTipService.ToolTip="{x:Bind helpers:LanguageService.Translate('删除'), Mode=OneWay}"
            Style="{StaticResource ToolbarIconButtonStyle}" BorderThickness="0"
        Foreground="{ThemeResource TextFillColorTabBarBrush}"
        Click="ToolbarDelete_Click">
                                <FontIcon Glyph="&#xE74D;" />
                            </Button>
                            <Button x:Name="ToolbarFavoriteButton"
                            helpers:PressAnimationHelper.EnableBounce="True"
        ToolTipService.ToolTip="{x:Bind helpers:LanguageService.Translate('收藏/取消收藏'), Mode=OneWay}"
            Style="{StaticResource ToolbarIconButtonStyle}" BorderThickness="0"
        Foreground="{ThemeResource TextFillColorTabBarBrush}"
        Click="ToolbarFavorite_Click">
                                <FontIcon x:Name="ToolbarFavoriteIcon" Glyph="&#xE734;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 内容栏 -->
                    <Grid x:Name="ContentHost" Grid.Row="1" Padding="2,3,2,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ShortcutGridHost"
                            Grid.Column="0"
                            CornerRadius="6" 
                            BorderThickness="0.6" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            RightTapped="ShortcutGrid_RightTapped"
                            >
                            <Grid x:Name="ShortcutInteractionHost"
                              Padding="16"
                              AllowDrop="True"
                              DragOver="ShortcutInteractionHost_DragOver"
                              Drop="ShortcutInteractionHost_Drop"
                              Background="Transparent"
                              PointerPressed="ShortcutGrid_PointerPressed"
                              PointerMoved="ShortcutGrid_PointerMoved"
                              PointerReleased="ShortcutGrid_PointerReleased"
                              PointerCanceled="ShortcutGrid_PointerCanceled"
                              PointerCaptureLost="ShortcutGrid_PointerCaptureLost">
                                <Grid.Resources>
                                    <UniformGridLayout x:Key="ShortcutUniformGridLayout"
                                                   MinItemWidth="90"
                                                   MinItemHeight="110"
                                                   MinColumnSpacing="8"
                                                   MinRowSpacing="8" />
                                </Grid.Resources>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                    </Grid.ColumnDefinitions>
                                <ScrollViewer x:Name="ShortcutScrollViewer"
              Grid.Column="0"
              Loaded="ShortcutScrollViewer_Loaded"
              ViewChanged="ShortcutScrollViewer_ViewChanged"
              SizeChanged="CustomScrollViewer_SizeChanged"
              VerticalScrollBarVisibility="Hidden"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollMode="Auto"
              HorizontalScrollMode="Disabled"
              IsTabStop="False">
                                    <ItemsRepeater x:Name="ShortcutGrid"
                DragStarting="ShortcutInteractionHost_DragStarting"
                SizeChanged="ShortcutRepeater_SizeChanged"
                helpers:FontSizeHelper.ApplyGlobalFontScale="True"
                helpers:FontSizeHelper.InitialFontSize="{x:Bind helpers:FontSizeHelper.ContentInitialFontSize}"
                Layout="{StaticResource ShortcutUniformGridLayout}"
                DoubleTapped="ShortcutGrid_DoubleTapped"
               ElementPrepared="ShortcutRepeater_ElementPrepared"
               ElementClearing="ShortcutRepeater_ElementClearing">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:ShortcutItem">
                                                <Grid Width="90" Height="110"
           ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}">

                                                    <!--Opacity="{x:Bind DraggedOpacity, Mode=OneWay}"-->
                                                    <Grid x:Name="ShortcutMotionHost"
                                                      Opacity="0"
                                                      >
                                                        <Border x:Name="ShortcutCard"
helpers:PressAnimationHelper.EnableBounce="True"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="6"
                            Padding="6">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                                                <!-- 叠在一起：FontIcon 默认可见，Image 默认隐藏 -->
                                                                <Grid Width="48" Height="48">
                                                                    <FontIcon x:Name="ItemIcon"
          Glyph="{x:Bind DisplayGlyph, Mode=OneWay}"
              FontSize="32"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"/>
                                                                    <Image x:Name="ItemThumbnail"
           Width="48" Height="48"
           Stretch="Uniform"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
           Visibility="Collapsed"/>
                                                                </Grid>
                                                    <TextBlock x:Name="ItemName"
           FontSize="{x:Bind helpers:FontSizeHelper.ContentInitialFontSize}"
           TextTrimming="CharacterEllipsis"
           MaxLines="2"
           TextAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="ShortcutSelectionVisual"
                            IsHitTestVisible="False"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="2"
                            CornerRadius="6"
                            Opacity="0" />

                                                    </Grid>
                                                    <Border x:Name="ShortcutDragPlaceholder"
                        Visibility="{x:Bind DragPlaceholderVisibility, Mode=OneWay}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="1.5"
                        CornerRadius="6"
                        Background="#103B82F6"
                        IsHitTestVisible="False"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>
                                    <Grid x:Name="ShortcutScrollBarTrack" Grid.Column="1" Margin="1,4,1,4"
                                          Opacity="0" IsHitTestVisible="False"
                                          SizeChanged="ShortcutScrollBarTrack_SizeChanged"
                                          PointerPressed="CustomScrollBarTrack_PointerPressed"
                                          PointerMoved="CustomScrollBarThumb_PointerMoved"
                                          PointerReleased="CustomScrollBarThumb_PointerReleased"
                                          PointerCaptureLost="CustomScrollBarThumb_PointerCaptureLost">
                                        <Border x:Name="ShortcutScrollBarTrackFill" Background="Transparent" Opacity="0" CornerRadius="4"/>
                                        <Border x:Name="ShortcutScrollBarThumb" Height="24" VerticalAlignment="Top"
                                                Background="Transparent" CornerRadius="4"
                                                Opacity="0.9" PointerPressed="CustomScrollBarThumb_PointerPressed"/>
                                    </Grid>
                                </Grid>

                                <Canvas x:Name="ShortcutDragCanvas"
                                     IsHitTestVisible="False"
                                     Canvas.ZIndex="20" />
                                <Canvas x:Name="ShortcutSelectionCanvas"
                                     IsHitTestVisible="False"
                                     Canvas.ZIndex="10">
                                    <Rectangle x:Name="ShortcutSelectionRectangle"
                                            Visibility="Collapsed"
                                            Fill="#223B82F6"
                                            Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                            StrokeThickness="1" />
                                </Canvas>
                                <!-- ⭐ 空状态 -->
                                <StackPanel x:Name="EmptyHintPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                                        Opacity="1" 
                    Spacing="10"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="52"
                      Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                                    <TextBlock x:Name="EmptyHintText"
                       Text="{x:Bind helpers:LanguageService.Translate('还没有内容'), Mode=OneWay}"
                       FontSize="{x:Bind helpers:FontSizeHelper.ContentHintFontSize}"
                       TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <views:SettingsView x:Name="SettingsViewControl"
                                                 Canvas.ZIndex="100"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch"
                                                 Visibility="Collapsed"
                                                 Opacity="0" />
                            </Grid>

                        </Border>
                        <Border x:Name="EditHost"
                            Grid.Column="1"
                            Width="0"
                            Visibility="Collapsed"
                            Margin="5,0,0,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            CornerRadius="8" 
                            BorderThickness="0.6" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <views:CategoryEditPanel x:Name="CategoryEditPanelControl"
                                 Visibility="Collapsed"/>
                                <views:TabEditPanel x:Name="TabEditPanelControl"
                                    Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                    </Grid>
                    </Grid>
                    </Grid>
            </Border>
            </Grid>
            
           
        <Border x:Name="MissingFilesNotice" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="16,0,0,50" Padding="14,10" CornerRadius="8" MaxWidth="480"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="Collapsed" Canvas.ZIndex="9998">
            <StackPanel Spacing="8">
                <TextBlock x:Name="MissingFilesNoticeText" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{x:Bind helpers:LanguageService.Translate('查看'), Mode=OneWay}"
                            CornerRadius="8"
                            Click="MissingFilesNoticeView_Click" />
                    <Button Content="{x:Bind helpers:LanguageService.Translate('关闭'), Mode=OneWay}"
                             CornerRadius="8"
                            Click="MissingFilesNoticeClose_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- ⭐ 新增：左下角 Toast 浮层 -->
        <Grid x:Name="ToastHost"
              HorizontalAlignment="Left"
              VerticalAlignment="Bottom"
              Margin="16,0,0,50"
              IsHitTestVisible="False"
              Visibility="Collapsed"
              Canvas.ZIndex="9999">
            <Border x:Name="ToastBorder"
                    CornerRadius="8"
                    Padding="14,10"
                    MinWidth="140"
                    MaxWidth="360"
                    BorderThickness="0.6">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastTranslate" Y="20" />
                </Border.RenderTransform>

                <TextBlock x:Name="ToastText"
                           TextWrapping="Wrap"
                           FontSize="{x:Bind helpers:FontSizeHelper.ContentHintFontSize}"
                           MaxLines="6"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
        <Canvas x:Name="GlobalDragLayer"
        IsHitTestVisible="False"
        Canvas.ZIndex="9999"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"/>
    </Grid>
</Window>
